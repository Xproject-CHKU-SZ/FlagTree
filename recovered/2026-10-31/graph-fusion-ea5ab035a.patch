+"""Scoped P800 compiler repairs; all computation is generated by Inductor.
+
+The legacy backend bridge is needed by the deployed P800 runtime. Newer XPU
+backends carry an explicit resource context and do not need that bridge.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+import hashlib
+from pathlib import Path
+
+_RESOURCE = ContextVar("flagtree_p800_compile_resource", default=None)
+
+
+def policy_key():
+    names = ("_p800_compiler.py", "_p800_precision.py", "_p800_activation.py", "_p800_tables.py", "_p800_division.py",
+             "_resource_codegen.py", "_p800_native_activation.py", "_p800_parallel_rne.py")
+    return hashlib.sha256(b"".join((Path(__file__).parent / n).read_bytes() for n in names)).hexdigest()[:16]
+
+
+@contextmanager
+def resource_scope(resource):
+    """Apply repairs when compiling a bound P800 native kernel, including async loads."""
+    if resource not in ("sdnn", "cluster"):
+        raise ValueError("explicit resource required")
+    from torch._dynamo.convert_frame import compile_lock
+    from triton.backends.xpu.compiler import XPUBackend
+    from triton._C.libtriton import xpu
+    from ._p800_precision import compilation_scope
+    from ._p800_native_activation import install_stage, activation_scope
+    try:
+        from triton.backends.xpu.resource_context import resource_scope as native_scope
+    except ModuleNotFoundError as exc:
+        if exc.name != "triton.backends.xpu.resource_context":
+            raise
+        native_scope = None
+    with compile_lock:
+        if _RESOURCE.get() is not None:
+            raise RuntimeError("nested P800 binary compilation is unsupported")
+        token = _RESOURCE.set(resource)
+        original_parse, original_ttxir = XPUBackend.parse_options, XPUBackend.make_ttxir
+
+        candidate_ttxir = original_ttxir
+
+        def parse_options(backend, options):
+            requested = _RESOURCE.get()
+            if requested is not None and backend.target.arch == 3:
+                options = dict(options, is_sdnn=requested == "sdnn")
+            return original_parse(backend, options)
+
+        def make_ttxir(mod, metadata, options):
+            requested = _RESOURCE.get() if options.arch == 3 else None
+            if requested == "cluster" and xpu.is_sdnn_kernel(mod):
+                raise RuntimeError("unsupported_resource: native compiler requires SDNN for this dot/MMA kernel")
+            result = candidate_ttxir(mod, metadata, options)
+            if requested and ("sdnn" if metadata["is_sdnn"] else "cluster") != requested:
+                raise RuntimeError("native resource mismatch")
+            return result
+
+        try:
+            if native_scope is None:
+                candidate_ttxir = install_stage(original_ttxir)
+            if native_scope is not None:
+                with native_scope(resource), compilation_scope():
+                    yield
+            else:
+                XPUBackend.parse_options = parse_options
+                XPUBackend.make_ttxir = staticmethod(make_ttxir)
+                with activation_scope(), compilation_scope():
+                    yield
+        finally:
+            XPUBackend.parse_options = original_parse
+            XPUBackend.make_ttxir = staticmethod(original_ttxir)
+            _RESOURCE.reset(token)
+
+
+def active():
+    return _RESOURCE.get() is not None
diff --git a/python/triton/experimental/graph_fusion/_p800_division.py b/python/triton/experimental/graph_fusion/_p800_division.py
new file mode 100644
index 000000000..d21c0e201
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_p800_division.py
@@ -0,0 +1,73 @@
+"""Legalize full tensor SDNN division into per-row SDNN ops.
+
+Native division loads one 32-value denominator coefficient vector and applies
+it to every row. Splitting the tensor rows retains native instruction lowering
+and synchronization while making each coefficient vector belong to one row.
+This is a generic scalar operation repair, with no GEMM or fusion template.
+"""
+import os
+import re
+from pathlib import Path
+
+
+def split_division_rows(mod, output_dir):
+    from triton._C.libtriton import ir
+    # This pinned native build returns an empty string from module.__str__.
+    # Use its pass reproducer to serialize the real module under the compile lock.
+    previous = os.environ.get('TRITON_REPRODUCER_PATH')
+    prefix = str(Path(output_dir) / 'division-input')
+    os.environ['TRITON_REPRODUCER_PATH'] = prefix
+    try:
+        pm = ir.pass_manager(mod.context)
+        pm.run(mod, 'before_division_repair')
+        source = Path(prefix + '.before_division_repair.repro.mlir').read_text()
+    finally:
+        if previous is None:
+            os.environ.pop('TRITON_REPRODUCER_PATH', None)
+        else:
+            os.environ['TRITON_REPRODUCER_PATH'] = previous
+    assert source.strip(), 'cannot inspect native SDNN module'
+    records = []
+    pattern = re.compile(
+        r'^(?P<indent>\s*)sdnn\.ew div (?P<dst>%[\w]+) src0 (?P<a>%[\w]+) src1 (?P<b>%[\w]+) '
+        r'\{(?P<attrs>[^\n]+)\} : \((?P<type>memref<(?P<m>\d+)x(?P<n>\d+)xf32, #[\w]+>), '
+        r'(?P=type), (?P=type)\) -> \(\)$', re.M)
+
+    def rewrite(match):
+        m, n = int(match['m']), int(match['n'])
+        if m == 1:
+            return match[0]
+        attrs = match['attrs']
+        ordinary = re.sub(r'(?:signal|wait)(?:_cached)? = array<i32: [^>]+>,? ?', '', attrs)
+        ordinary = ordinary.rstrip(', ')
+        signals = re.findall(r'(?:signal|signal_cached) = array<i32: [^>]+>', attrs)
+        waits = re.findall(r'(?:wait|wait_cached) = array<i32: [^>]+>', attrs)
+        prefix = f'%f06_div_{len(records)}_'
+        lines = []
+        for row in range(m):
+            ty = f'memref<1x{n}xf32, strided<[{n}, 1], offset: {row*n}>>'
+            views = []
+            by_operand = {}
+            for role in ('dst', 'a', 'b'):
+                operand = match[role]
+                if operand not in by_operand:
+                    name = f'{prefix}{row}_{role}'
+                    lines.append(
+                        f'{name} = memref.subview {operand}[{row}, 0] [1, {n}] [1, 1] : {match["type"]} to {ty}')
+                    by_operand[operand] = name
+                views.append(by_operand[operand])
+            row_attrs = ', '.join([ordinary] + (waits if row == 0 else []) + (signals if row == m - 1 else []))
+            lines.append(
+                f'sdnn.ew div {views[0]} src0 {views[1]} src1 {views[2]} {{{row_attrs}}} : ({ty}, {ty}, {ty}) -> ()')
+        records.append({'rows': m, 'columns': n, 'dtype': 'f32', 'original': match[0].strip(), 'operations_after': m})
+        return '\n'.join(match['indent'] + line for line in lines)
+
+    changed = pattern.sub(rewrite, source)
+    if not records:
+        return mod, records
+    path = Path(output_dir) / 'sdnn-div-row-repair.mlir'
+    path.write_text(changed)
+    result = ir.parse_mlir_module(str(path), mod.context)
+    result.context = mod.context
+    assert result.verify()
+    return result, records
diff --git a/python/triton/experimental/graph_fusion/_p800_matmul.py b/python/triton/experimental/graph_fusion/_p800_matmul.py
new file mode 100644
index 000000000..fb18c026d
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_p800_matmul.py
@@ -0,0 +1,91 @@
+"""Admit P800 to native Inductor GEMM templates and inspect the actual binary.
+
+No arithmetic, tile, grid, device code or backend pass is supplied here.
+The NVIDIA SM-count heuristic is scoped to one identified P800 compilation.
+"""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+import hashlib
+from pathlib import Path
+import threading
+
+_DEVICE = ContextVar("flagtree_p800_template_device", default=None)
+_LOCK = threading.RLock()
+
+
+def is_p800(value):
+    if value.device.type != "cuda":
+        return False
+    from triton.runtime import driver
+    import torch
+    active = driver.active
+    cls = type(active)
+    if cls.__module__ != "triton.backends.xpu.driver" or cls.__name__ != "XPUDriver":
+        return False
+    with torch.cuda.device(value.device):
+        target = active.get_current_target()
+    # The report P800 identifies itself as XPU architecture 3, warp_size=1.
+    # Other XPU generations need their own validation, not a CUDA-alias guess.
+    return type(target.arch) is int and target.arch == 3 and target.warp_size == 1
+
+
+@contextmanager
+def native_template_eligibility(device):
+    import torch
+    from torch._dynamo.convert_frame import compile_lock
+    from torch._inductor import utils
+
+    index = device.index if device.index is not None else torch.cuda.current_device()
+    with compile_lock, _LOCK:
+        original = getattr(utils, "is_big_gpu", None)
+        if not callable(original):
+            raise RuntimeError("P800 native GEMM eligibility API is unavailable")
+        if _DEVICE.get() is not None:
+            raise RuntimeError("nested P800 template compilation is unsupported")
+        token = _DEVICE.set(index)
+
+        def eligible(queried_index):
+            requested = _DEVICE.get()
+            if requested is not None and queried_index == requested:
+                return True
+            return original(queried_index)
+
+        utils.is_big_gpu = eligible
+        try:
+            yield
+        finally:
+            if utils.is_big_gpu is eligible:
+                utils.is_big_gpu = original
+            _DEVICE.reset(token)
+
+
+def inspect_bound_binary(compiled, kernel_name):
+    """Require one real bound XPU binary; never infer its resource from mm."""
+    from torch._inductor.codecache import PyCodeCache
+
+    cache = getattr(PyCodeCache, "cache", {})
+    module = cache.get(compiled.cache_key)
+    if module is None or Path(module.__file__).read_text() != compiled.source_code:
+        raise RuntimeError("P800 generated wrapper identity could not be verified")
+    tuner = getattr(module, kernel_name, None)
+    if tuner is None or not callable(getattr(tuner, "precompile", None)):
+        raise RuntimeError("P800 generated kernel binding could not be verified")
+    tuner.precompile()
+    if len(tuner.launchers) != 1:
+        raise RuntimeError("P800 native GEMM did not resolve to one launcher")
+    binary = getattr(tuner.launchers[0], "__globals__", {}).get("bin")
+    metadata = getattr(binary, "metadata", None)
+    is_sdnn = getattr(metadata, "is_sdnn", None)
+    if type(is_sdnn) is not bool or getattr(metadata, "arch", None) != 3:
+        raise RuntimeError("P800 bound binary resource or architecture is unverified")
+    return {
+        "resource": "sdnn" if is_sdnn else "cluster",
+        "binary_hash": str(binary.hash),
+        "kernel_name": metadata.name,
+        "asm_sha256": {
+            key: hashlib.sha256(value if isinstance(value, bytes) else str(value).encode()).hexdigest()
+            for key, value in binary.asm.items()
+        },
+        "scope": "generated_wrapper_and_bound_native_binary",
+    }
diff --git a/python/triton/experimental/graph_fusion/_p800_native_activation.py b/python/triton/experimental/graph_fusion/_p800_native_activation.py
new file mode 100644
index 000000000..092c2f45c
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_p800_native_activation.py
@@ -0,0 +1,393 @@
+"""Experimental native SDNN activation legalization; no GEMM or kernel template."""
+import os
+import re
+from pathlib import Path
+import json
+import tempfile
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+_ENABLED = ContextVar("p800_native_activation_enabled", default=False)
+
+
+@contextmanager
+def activation_scope():
+    if _ENABLED.get():
+        raise RuntimeError("nested native activation lowering is unsupported")
+    token = _ENABLED.set(True)
+    try:
+        yield
+    finally:
+        _ENABLED.reset(token)
+
+
+def serialize(mod, directory, name):
+    from triton._C.libtriton import ir
+    saved = os.environ.get('TRITON_REPRODUCER_PATH')
+    prefix = str(Path(directory) / name)
+    os.environ['TRITON_REPRODUCER_PATH'] = prefix
+    try:
+        ir.pass_manager(mod.context).run(mod, name)
+        return Path(prefix + '.' + name + '.repro.mlir').read_text()
+    finally:
+        if saved is None:
+            os.environ.pop('TRITON_REPRODUCER_PATH', None)
+        else:
+            os.environ['TRITON_REPRODUCER_PATH'] = saved
+
+
+def parse(mod, source, path):
+    from triton._C.libtriton import ir, passes
+    Path(path).write_text(source)
+    result = ir.parse_mlir_module(str(path), mod.context)
+    result.context = mod.context
+    pm = ir.pass_manager(mod.context)
+    passes.common.add_canonicalizer(pm)
+    passes.common.add_cse(pm)
+    pm.run(result, 'candidate_cleanup')
+    assert result.verify()
+    return result
+
+
+def relu(mod, directory, mode):
+    text = serialize(mod, directory, 'before_relu')
+    zero = set(re.findall(r'(%[\w]+) = arith.constant dense<0\.000000e\+00> : tensor<[^>]+>', text))
+    compares = {
+        name: (left, right, ty)
+        for name, left, right, ty in re.findall(r'(%[\w]+) = arith.cmpf ogt, (%[\w]+), (%[\w]+) : (tensor<[^>]+>)',
+                                                text)
+    }
+    records = []
+
+    def replace(m):
+        dst, cond, left, right = m['dst'], m['cond'], m['left'], m['right']
+        if cond not in compares or compares[cond][:2] != (left, right) or left not in zero:
+            return m[0]
+        ty = compares[cond][2]
+        records.append({'input': right, 'zero': left, 'type': ty})
+        op = {'maximum': 'arith.maximumf', 'native_relu_placeholder': 'arith.maxnumf'}[mode]
+        exact = re.search(re.escape(right) + r' = arith.extf %[\w]+ : tensor<[^>]+xbf16> to ' + re.escape(ty), text)
+        annotation = ' {f06.bf16_exact = true}' if exact else ''
+        return f'{dst} = {op} {right}, {left}{annotation} : {ty}'
+
+    changed = re.sub(r'(?P<dst>%[\w]+) = arith.select (?P<cond>%[\w]+), (?P<left>%[\w]+), (?P<right>%[\w]+) : [^\n]+',
+                     replace, text)
+    if not records: return mod, []
+    assert len(records) == 1, records
+    return parse(mod, changed, Path(directory) / 'relu-candidate.mlir'), records
+
+
+def exact_gelu_to_placeholder(mod, directory):
+    text = serialize(mod, directory, 'before_gelu')
+    # Reserve exp for the temporary opcode only when no real exp exists.
+    # This fail-closed prototype does not touch tanh-GELU or arbitrary erf.
+    if re.search(r'\bmath\.exp\b', text): return mod, []
+    consts = {
+        n: float(v)
+        for n, v in re.findall(r'(%[\w]+) = arith.constant dense<([-+0-9.e]+)> : tensor<[^>]+>', text)
+    }
+    muls = {
+        n: (a, b, t)
+        for n, a, b, t in re.findall(r'(%[\w]+) = arith.mulf (%[\w]+), (%[\w]+) : (tensor<[^>]+>)', text)
+    }
+    adds = {
+        n: (a, b, t)
+        for n, a, b, t in re.findall(r'(%[\w]+) = arith.addf (%[\w]+), (%[\w]+) : (tensor<[^>]+>)', text)
+    }
+    erfs = re.findall(r'(%[\w]+) = tt.extern_elementwise (%[\w]+) \{[^\n]*?symbol = "(?:_ZN3xpu3erfEf|__nv_erff)"',
+                      text)
+    records = []
+
+    def other_const(pair, value):
+        a, b = pair[:2]
+        if a in consts and abs(consts[a] - value) < 1e-8: return b
+        if b in consts and abs(consts[b] - value) < 1e-8: return a
+        return None
+
+    for erf, scaled in erfs:
+        if scaled not in muls: continue
+        x = other_const(muls[scaled], 0.707106769)
+        if x is None: continue
+        halves = [n for n, pair in muls.items() if other_const(pair, 0.5) == x]
+        plus = [n for n, pair in adds.items() if other_const(pair, 1.0) == erf]
+        for n, (a, b, ty) in muls.items():
+            if (a in halves and b in plus) or (b in halves and a in plus):
+                old = f'{n} = arith.mulf {a}, {b} : {ty}'
+                assert old in text
+                suffix = n[1:]
+                new = (f'%f06_gelu_{suffix} = math.exp {x} : {ty}\n'
+                       f'    %f06_lo_{suffix} = arith.constant dense<-3.40282347e+38> : {ty}\n'
+                       f'    %f06_hi_{suffix} = arith.constant dense<3.40282347e+38> : {ty}\n'
+                       f'    %f06_max_{suffix} = arith.maxnumf {x}, %f06_lo_{suffix} : {ty}\n'
+                       f'    %f06_clip_{suffix} = arith.minnumf %f06_max_{suffix}, %f06_hi_{suffix} : {ty}\n'
+                       f'    %f06_guard_{suffix} = arith.subf {x}, %f06_clip_{suffix} : {ty}\n'
+                       f'    {n} = arith.addf %f06_gelu_{suffix}, %f06_guard_{suffix} : {ty}')
+                text = text.replace(old, new)
+                records.append({'result': n, 'input': x, 'erf': erf, 'semantic': 'exact GELU'})
+    if not records: return mod, []
+    assert len(records) == 1, {'erfs': erfs, 'records': records}
+    return parse(mod, text, Path(directory) / 'gelu-placeholder.mlir'), records
+
+
+def restore_gelu(mod, directory):
+    text = serialize(mod, directory, 'before_gelu_restore')
+    lines = text.splitlines()
+    changed = []
+    for i, line in enumerate(lines):
+        if 'sdnn.ew ' not in line or 'lut_func exp ' not in line: continue
+        assert 'lut_func gelu' not in text
+        # The native pass reselects interpolation size, range and overflow data.
+        # Keep all storage operands and already scheduled wait/signal events.
+        after = line.replace('lut_func exp ', 'lut_func gelu ')
+        after = re.sub(r'(?:kOverflow|kUnderflow|lut_max|lut_min) = [-+0-9.e]+ : f32,? ?', '', after)
+        lines[i] = after
+        changed.append({'before': line, 'after': after})
+    assert len(changed) == 1, changed
+    result = parse(mod, '\n'.join(lines) + '\n', Path(directory) / 'gelu-native.mlir')
+    return result, changed
+
+
+def bound_tanh_inputs(mod, directory, *, triton_bitcast=False):
+    text = serialize(mod, directory, 'before_tanh_guard')
+    pattern = re.compile(
+        r'(?P<dst>%[\w]+) = tt.extern_elementwise (?P<x>%[\w]+)(?P<attrs> \{[^\n]*symbol = "_ZN3xpu5tanhfEf"\}) : \((?P<ty>tensor<[^>]+xf32>)\) -> (?P=ty)'
+    )
+
+    def replace(m):
+        dst, x, ty = m['dst'], m['x'], m['ty']
+        tag = dst[1:]
+        p = f'%tanh_guard_{tag}_'
+        it = ty.replace('f32>', 'i32>')
+        bt = ty.replace('f32>', 'i1>')
+        lines = [
+            f'{p}bits = arith.bitcast {x} : {ty} to {it}',
+            f'{p}mask = arith.constant dense<2147483647> : {it}',
+            f'{p}signmask = arith.constant dense<2147483648> : {it}',
+            f'{p}limit = arith.constant dense<1098907648> : {it}',
+            f'{p}inf = arith.constant dense<2139095040> : {it}',
+            f'{p}quiet = arith.constant dense<4194304> : {it}',
+            f'{p}fractionmask = arith.constant dense<8388607> : {it}',
+            f'{p}zero = arith.constant dense<0> : {it}',
+            f'{p}mag = arith.andi {p}bits, {p}mask : {it}',
+            f'{p}sign = arith.andi {p}bits, {p}signmask : {it}',
+            f'{p}large = arith.cmpi ugt, {p}mag, {p}limit : {it}',
+            f'{p}limited = arith.ori {p}sign, {p}limit : {it}',
+            f'{p}safe_bits = arith.select {p}large, {p}limited, {p}bits : {bt}, {it}',
+            f'{p}safe = arith.bitcast {p}safe_bits : {it} to {ty}',
+            f'{p}raw = tt.extern_elementwise {p}safe{m["attrs"]} : ({ty}) -> {ty}',
+            f'{p}rawbits = arith.bitcast {p}raw : {ty} to {it}',
+            f'{p}exponent = arith.andi {p}bits, {p}inf : {it}',
+            f'{p}fraction = arith.andi {p}bits, {p}fractionmask : {it}',
+            f'{p}expmax = arith.cmpi eq, {p}exponent, {p}inf : {it}',
+            f'{p}nonzero_fraction = arith.cmpi ne, {p}fraction, {p}zero : {it}',
+            f'{p}isnan = arith.andi {p}expmax, {p}nonzero_fraction : {bt}',
+            f'{p}nanbits = arith.ori {p}bits, {p}quiet : {it}',
+            f'{p}result = arith.select {p}isnan, {p}nanbits, {p}rawbits : {bt}, {it}',
+            f'{dst} = arith.bitcast {p}result : {it} to {ty}',
+        ]
+        body = '\n    '.join(lines)
+        if triton_bitcast:
+            body = re.sub(r'arith.bitcast (%[\w]+) : (tensor<[^>]+>) to (tensor<[^>]+>)', r'tt.bitcast \1 : \2 -> \3',
+                          body)
+        return body
+
+    text, count = pattern.subn(replace, text)
+    if not count: return mod, []
+    return parse(mod, text,
+                 Path(directory) / 'tanh-guard.mlir'), [{
+                     'count': count, 'bounds': [-16.0, 16.0], 'nan': 'integer classify and restore quiet payload',
+                     'scope': 'native SDNN f32 tanh input/output'
+                 }]
+
+
+def preserve_multiply_specials(mod, directory):
+    """Repair SDNN multiplication zero suppression without changing finite results.
+
+    Native EW multiplication can erase NaN/Inf when its second input is zero.
+    Keep its arithmetic, and use integer classifications to restore IEEE NaN
+    results. A nonzero normal finite constant or a square cannot encounter that
+    invalid operand pair. No matrix, layout, or launch template is supplied.
+    """
+    import math
+    source = serialize(mod, directory, 'before_ieee_multiply')
+    constants = {}
+    for name, value in re.findall(r'(%\w+) = arith.constant dense<([^>]+)> : tensor<(?:\d+x)+f32>', source):
+        try:
+            number = float(value)
+        except ValueError:
+            continue
+        if math.isfinite(number) and 2**-126 <= abs(number) <= (2 - 2**-23) * 2**127:
+            constants[name] = number
+    records = []
+    pattern = re.compile(
+        r'^(?P<indent>\s*)(?P<dst>%\w+) = arith\.mulf (?P<a>%\w+), (?P<b>%\w+) : (?P<ty>tensor<(?:\d+x)+f32>)$', re.M)
+
+    def replace(m):
+        if m['a'] == m['b'] or m['a'] in constants or m['b'] in constants:
+            return m[0]
+        i = len(records)
+        prefix = f'%ieee_mul_{i}_'
+        ty = m['ty']
+        ity = ty.replace('f32>', 'i32>')
+        bty = ty.replace('f32>', 'i1>')
+        a = m['a']
+        b = m['b']
+        lines = [
+            f'{prefix}raw = arith.mulf {a}, {b} : {ty}',
+            f'{prefix}mask = arith.constant dense<2147483647> : {ity}',
+            f'{prefix}inf = arith.constant dense<2139095040> : {ity}',
+            f'{prefix}zero = arith.constant dense<0> : {ity}',
+            f'{prefix}nan = arith.constant dense<2143289344> : {ity}',
+            f'{prefix}abits = arith.bitcast {a} : {ty} to {ity}',
+            f'{prefix}bbits = arith.bitcast {b} : {ty} to {ity}',
+            f'{prefix}amag = arith.andi {prefix}abits, {prefix}mask : {ity}',
+            f'{prefix}bmag = arith.andi {prefix}bbits, {prefix}mask : {ity}',
+            f'{prefix}anan = arith.cmpi ugt, {prefix}amag, {prefix}inf : {ity}',
+            f'{prefix}bnan = arith.cmpi ugt, {prefix}bmag, {prefix}inf : {ity}',
+            f'{prefix}ainf = arith.cmpi eq, {prefix}amag, {prefix}inf : {ity}',
+            f'{prefix}binf = arith.cmpi eq, {prefix}bmag, {prefix}inf : {ity}',
+            f'{prefix}azero = arith.cmpi eq, {prefix}amag, {prefix}zero : {ity}',
+            f'{prefix}bzero = arith.cmpi eq, {prefix}bmag, {prefix}zero : {ity}',
+            f'{prefix}invalid_a = arith.andi {prefix}ainf, {prefix}bzero : {bty}',
+            f'{prefix}invalid_b = arith.andi {prefix}binf, {prefix}azero : {bty}',
+            f'{prefix}invalid = arith.ori {prefix}invalid_a, {prefix}invalid_b : {bty}',
+            f'{prefix}any_nan = arith.ori {prefix}anan, {prefix}bnan : {bty}',
+            f'{prefix}bad = arith.ori {prefix}invalid, {prefix}any_nan : {bty}',
+            f'{prefix}rawbits = arith.bitcast {prefix}raw : {ty} to {ity}',
+            f'{prefix}fixed = arith.select {prefix}bad, {prefix}nan, {prefix}rawbits : {bty}, {ity}',
+            f"{m['dst']} = arith.bitcast {prefix}fixed : {ity} to {ty}",
+        ]
+        records.append({
+            'result': m['dst'], 'type': ty, 'finite_arithmetic': 'unchanged', 'repair':
+            'NaN propagation and zero-times-Inf'
+        })
+        return '\n'.join(m['indent'] + line for line in lines)
+
+    changed = pattern.sub(replace, source)
+    return (parse(mod, changed, Path(directory) / 'ieee-multiply.mlir') if records else mod), records
+
+
+def prepare(mod, metadata):
+    if not _ENABLED.get():
+        metadata['native_exact_gelu'] = metadata['native_relu'] = '[]'
+        return mod
+    # Metadata prevents the temporary exp opcode from escaping to execution.
+    # Any mixed real-exp graph keeps the original erf lowering instead.
+    with tempfile.TemporaryDirectory(prefix='native-activation-', dir=os.environ['TRITON_CACHE_DIR']) as directory:
+        mod, tanh_bounds = bound_tanh_inputs(mod, directory)
+        mod, gelu = exact_gelu_to_placeholder(mod, directory)
+        mod, relu_records = relu(mod, directory, 'native_relu_placeholder')
+        mod, multiply = preserve_multiply_specials(mod, directory)
+    metadata['native_tanh_bounds'] = json.dumps(tanh_bounds)
+    metadata['native_ieee_multiply'] = json.dumps(multiply)
+    metadata['native_exact_gelu'] = json.dumps(gelu)
+    metadata['native_relu'] = json.dumps(relu_records)
+    return mod
+
+
+def restore_relu(mod, directory):
+    """Standalone native maximum discards NaN; linear's ReLU propagates it."""
+    text = serialize(mod, directory, 'before_relu_restore')
+    zero = set(re.findall(r'(%[\w]+) = arith.constant 0\.000000e\+00 : f32', text))
+    ones = re.findall(r'(%[\w]+) = arith.constant 1\.000000e\+00 : f32', text)
+    records = []
+    pattern = re.compile(
+        r'^(?P<indent>\s*)sdnn\.ew maximum (?P<dst>%[\w]+) src0 (?P<src>%[\w]+) c (?P<c>%[\w]+) \{(?P<attrs>[^\n]+)\} : \((?P<dstty>memref<[^>]+>), (?P<srcty>memref<[^>]+>), f32\) -> \(\)$',
+        re.M)
+
+    def replace(match):
+        if match['c'] not in zero: return match[0]
+        assert ones, 'cannot identify exact linear coefficient'
+        result = (f"{match['indent']}sdnn.ew linear {match['dst']} src0 {match['src']} a {ones[0]} "
+                  f"{{activation = 1 : i32, {match['attrs']}}} : ({match['dstty']}, {match['srcty']}, f32) -> ()")
+        records.append({'from': match[0].strip(), 'to': result.strip()})
+        return result
+
+    changed = pattern.sub(replace, text)
+    assert records or 'activation = 1 : i32' in text, 'ReLU was not lowered to a native activation'
+    return (parse(mod, changed, Path(directory) / 'relu-native.mlir') if records else mod), records
+
+
+def retune_gelu(mod, metadata):
+    """Preserve the native 512-entry ABI, refine the GELU interpolation grid."""
+    from triton._C.libtriton import xpu
+    with tempfile.TemporaryDirectory(prefix='gelu-lut-', dir=os.environ['TRITON_CACHE_DIR']) as directory:
+        text = serialize(mod, directory, 'before_gelu_lut_refinement')
+        records = []
+
+        def replace(m):
+            line = m[0]
+            assert 'packedid = 887693 : ui32' in line, 'unknown native GELU table ABI'
+            new = line.replace('packedid = 887693', 'packedid = 887629')
+            for name, value in (('lut_min', '-8.000000e+00'), ('lut_max', '7.984375e+00'),
+                                ('kOverflow', '1.000000e+00'), ('kUnderflow', '0.000000e+00')):
+                new, count = re.subn(name + r' = [-+0-9.e]+ : f32', name + ' = ' + value + ' : f32', new)
+                assert count == 1, (name, line)
+            records.append({'before': line, 'after': new})
+            return new
+
+        changed = re.sub(r'^.*sdnn\.ew .*lut_func gelu .*$', replace, text, flags=re.M)
+        assert len(records) == 1
+        result = parse(mod, changed, Path(directory) / 'gelu-lut-refined.mlir')
+        info = xpu.get_lut_info(result)
+        assert list(info) == ['tt.gelu']
+        gelu = info['tt.gelu']
+        assert (gelu.dtype, gelu.mode, gelu.size, gelu.min, gelu.interval) == (0, 1, 512, -8.0, 0.015625)
+        metadata['native_gelu_lut_refinement'] = json.dumps(records)
+        return result
+
+
+def install_stage(native):
+    """Split the native pass pipeline once, before its activation table pass.
+
+    The original scheduling, bufferization, native instruction selection and
+    synchronization passes remain in their original order. Unknown pipeline
+    versions fail closed instead of silently emitting a placeholder function.
+    """
+    import ast
+    import inspect
+    import textwrap
+    tree = ast.parse(textwrap.dedent(inspect.getsource(native)))
+    tree.body[0].decorator_list = []
+
+    class InsertStage(ast.NodeTransformer):
+        count = 0
+        table_count = 0
+
+        def visit_If(self, node):
+            self.generic_visit(node)
+            if ast.unparse(node.test) == "opt.exp_range != ':0'":
+                self.table_count += 1
+                return [node] + ast.parse(
+                    "if metadata.get('native_exact_gelu', '[]') != '[]':\n    pm.run(mod, 'after_native_activation_table')\n    mod = _native_retune_gelu(mod, metadata)\n    pm = ir.pass_manager(mod.context)\n    pm.enable_debug()"
+                ).body
+            return node
+
+        def visit_Expr(self, node):
+            if (isinstance(node.value, ast.Call) and isinstance(node.value.func, ast.Attribute)
+                    and node.value.func.attr == 'add_tritonsdnn_fuse_relu_activation_pass'):
+                self.count += 1
+                return [node] + ast.parse(
+                    "if metadata.get('native_exact_gelu', '[]') != '[]' or metadata.get('native_relu', '[]') != '[]':\n    pm.run(mod, 'before_native_activation')\n    mod = _native_restore_activation(mod, metadata)\n    pm = ir.pass_manager(mod.context)\n    pm.enable_debug()"
+                ).body
+            return node
+
+    patch = InsertStage()
+    tree = patch.visit(tree)
+    assert (patch.count, patch.table_count) == (1, 1), 'unknown native SDNN activation pipeline'
+
+    def restore(mod, metadata):
+        with tempfile.TemporaryDirectory(prefix='native-gelu-', dir=os.environ['TRITON_CACHE_DIR']) as directory:
+            if metadata.get('native_exact_gelu', '[]') != '[]':
+                mod, records = restore_gelu(mod, directory)
+                assert len(records) == len(json.loads(metadata['native_exact_gelu']))
+                metadata['native_exact_gelu_restored'] = json.dumps(records)
+            if metadata.get('native_relu', '[]') != '[]':
+                mod, records = restore_relu(mod, directory)
+                metadata['native_relu_restored'] = json.dumps(records)
+        return mod
+
+    namespace = dict(native.__globals__, _native_restore_activation=restore, _native_retune_gelu=retune_gelu)
+    ast.fix_missing_locations(tree)
+    exec(compile(tree, '<native_sdnn_activation_stage>', 'exec'), namespace)
+    return namespace['make_ttxir']
diff --git a/python/triton/experimental/graph_fusion/_p800_parallel_rne.py b/python/triton/experimental/graph_fusion/_p800_parallel_rne.py
new file mode 100644
index 000000000..2adea04e8
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_p800_parallel_rne.py
@@ -0,0 +1,158 @@
+"""Partition native SDNN pointwise RNE across its eight scalar control cores.
+
+The arithmetic body, buffers, GEMM, and activation remain compiler generated.
+Native sync_core(255) barriers bracket the disjoint writes. Existing event
+waits/signals and per-core memory fences are preserved. Native engine and
+memory completion precede broadcasting input readiness. No new event slots.
+"""
+import re
+from pathlib import Path
+
+
+def supported_launch(options):
+    # The native SDNN default is eight control cores; num_warps/core_num are
+    # unrelated compiler options and must not be used as the physical count.
+    return getattr(options, 'launch_cores', -1) in (None, -1, 8)
+
+
+def rewrite(source):
+    if 'scf.if ' in source or 'cf.cond_br ' in source:
+        return source, []  # Cannot prove every core reaches the barriers.
+    records = []
+    pattern = re.compile(r'^      sdnn\.core_specialize ins\([^\n]+\n.*?^      \}', re.M | re.S)
+
+    def change(match):
+        region = match[0]
+        header, body = region.split('\n', 1)
+        is_rne = 'arith.shrui' in body
+        is_bounds = 'arith.maximumf' in body and 'arith.minimumf' in body
+        is_multiply = 'c2143289344_i32' in header and 'c2139095040_i32' in header and 'arith.cmpi' in body and 'arith.select' in body
+        is_integer_bounds = 'c1098907648_i32' in header and 'arith.cmpi' in body and 'arith.select' in body
+        is_nan_restore = not is_rne and 'c4194304_i32' in header and 'c2139095040_i32' in header and 'arith.select' in body
+        is_bitcast_copy = ('xf32,' in header and 'xi32,' in header and 'arith.bitcast' in body
+                           and 'arith.cmpi' not in body and 'arith.select' not in body and not is_rne)
+        is_guard = is_multiply or is_integer_bounds or is_nan_restore or is_bitcast_copy
+        if 'attributes {little_core,' not in header or not (is_rne or is_bounds or is_guard):
+            return region
+        # Fail closed on new scheduling or dataflow forms. This pass only
+        # distributes the existing, independent, rectangular RNE loop nest.
+        assert '_cached' not in header and 'core_id' not in header
+        loops = list(re.finditer(r'scf.for (%\w+) = (%\w+) to (%\w+) step (%\w+) \{', body))
+        assert len(loops) == 2
+        constants = dict(re.findall(r'(%\w+) = arith.constant (\d+) : index', body))
+        outer, inner = loops
+        row, lo, hi, step = outer.groups()
+        col, clo, chi, cstep = inner.groups()
+        assert constants[lo] == constants[clo] == '0'
+        assert constants[step] == constants[cstep] == '1'
+        rows, cols = int(constants[hi]), int(constants[chi])
+        assert rows >= 8 and rows % 8 == 0
+        assert 'sdnn.layout = "CR_RowMajor"' in header
+        buffers = re.findall(r'memref<(\d+)x(\d+)x(f32|i32), (#[\w]+)>', header)
+        assert len(buffers) == header.count('memref<'), 'unsupported buffer type or rank'
+        if is_guard:
+            assert len(buffers) >= 2
+            assert cols % 16 == 0, 'guard row must span complete 64-byte cache lines'
+        else:
+            assert len(buffers) == (2 if is_rne else 4)
+            assert all(dtype == 'f32' for _, _, dtype, _ in buffers)
+        for m, n, dtype, layout in buffers:
+            assert (int(m), int(n)) == (rows, cols)
+            definition = f'{layout} = affine_map<(d0, d1) -> (d0 * {cols} + d1)>'
+            assert definition in source, 'parallel RNE requires contiguous non-overlapping rows'
+        accesses = re.findall(r'memref\.(?:load|store)[^\n]*\[([^]]+)\]', body)
+        assert accesses == [f'{row}, {col}'] * len(buffers)
+        # No hidden side effects, cross-element values, nested regions, or calls.
+        operations = re.findall(r'^\s+(?:%\w+ = )?([a-z_]+\.[a-z_]+)', body, re.M)
+        allowed = {
+            'arith.constant', 'scf.for', 'memref.load', 'memref.store', 'arith.bitcast', 'arith.andi', 'arith.ori',
+            'arith.cmpi', 'arith.select', 'arith.addi', 'arith.shrui', 'sdnn.core_specialize_return'
+        }
+        if is_guard:
+            assert set(operations) <= allowed, operations
+            assert operations.count('memref.store') == 1
+            assert operations.count('memref.load') == len(buffers) - 1
+            if is_bitcast_copy:
+                assert len(buffers) == 2 and {b[2] for b in buffers} == {'f32', 'i32'}
+                assert set(operations) <= {
+                    'arith.constant', 'scf.for', 'memref.load', 'memref.store', 'arith.bitcast',
+                    'sdnn.core_specialize_return'
+                }
+                assert operations.count('arith.bitcast') == 1
+            else:
+                assert operations.count('arith.select') >= 1
+        elif is_rne:
+            assert set(operations) <= allowed, operations
+            assert operations.count('memref.load') == operations.count('memref.store') == 1
+            assert operations.count('arith.select') == 2 and operations.count('arith.shrui') == 1
+            assert 'c32767_i32' in header and 'c-65536_i32' in header and 'c2139095040_i32' in header
+        else:
+            allowed_bounds = {
+                'arith.constant', 'scf.for', 'memref.load', 'memref.store', 'arith.maximumf', 'arith.minimumf',
+                'sdnn.core_specialize_return'
+            }
+            assert set(operations) <= allowed_bounds, operations
+            assert operations.count('memref.load') == 3 and operations.count('memref.store') == 1
+            assert operations.count('arith.maximumf') == operations.count('arith.minimumf') == 1
+        waits = [int(v.strip()) for v in re.search(r'wait = array<i32: ([^>]+)>', header)[1].split(',')]
+        signals = [int(v.strip()) for v in re.search(r'signal = array<i32: ([^>]+)>', header)[1].split(',')]
+        index = len(records)
+        mask = f'%f06_rne_sync_mask_{index}'
+        barrier = f'      llvm.call @llvm.xpu.sync_core({mask}) : (i32) -> ()'
+        lines = [f'      {mask} = arith.constant 255 : i32']
+        lines += [f'      sdnn.core_wait(3, {event})' for event in waits]
+        # Event waits were moved out of the original worker. Complete the
+        # producer operations before other cores observe the ready barrier;
+        # a barrier alone permits stale first-cache-line reads across tiles.
+        lines += [
+            f'      %f06_rne_mem_mask_{index} = arith.constant 7 : i32',
+            '      llvm.call @llvm.xpu.xfence() : () -> ()',
+            f'      llvm.call @llvm.xpu.mfence.v2(%f06_rne_mem_mask_{index}) : (i32) -> ()'
+        ]
+        lines.append(barrier)
+        clean = re.sub(r'(?:signal|wait) = array<i32: [^>]+>,? ?', '', header).replace(', }', '}')
+        partitions = []
+        for core in range(8):
+            start, end = rows * core // 8, rows * (core + 1) // 8
+            partitions.append([core, start, end])
+            attrs = f'little_core, core_id = {core} : i32,'
+            worker_header = clean.replace('little_core,', attrs)
+            worker_body = body[:outer.start(
+            )] + f'%f06_row_begin = arith.constant {start} : index\n        %f06_row_end = arith.constant {end} : index\n        ' + body[
+                outer.start():]
+            worker_body = worker_body.replace(outer[0],
+                                              f'scf.for {row} = %f06_row_begin to %f06_row_end step {step} {{', 1)
+            lines.append(worker_header + '\n' + worker_body)
+        lines.append(barrier)
+        lines += [f'      sdnn.core_arrive(3, {event})' for event in signals]
+        kind = ('rne_ieee_multiply' if is_rne else 'ieee_multiply') if is_multiply else (
+            'rne' if is_rne else 'nan_preserving_bounds')
+        if is_integer_bounds: kind = 'integer_tanh_bounds'
+        if is_nan_restore: kind = 'nan_restore'
+        if is_bitcast_copy: kind = 'bitcast_copy'
+        records.append({
+            'kind': kind, 'buffer_types': [b[2] for b in buffers], 'rows': rows, 'columns': cols, 'partitions':
+            partitions, 'leader': 3, 'synchronization': 'llvm.xpu.sync_core', 'mask': 255, 'original_waits': waits,
+            'original_signals': signals, 'arithmetic': 'unchanged', 'input_handoff_fence': 'xfence+mfence(7)'
+        })
+        return '\n'.join(lines)
+
+    changed = pattern.sub(change, source)
+    if records:
+        assert '@llvm.xpu.sync_core' not in source
+        changed = changed.replace(
+            'module {',
+            'module {\n  llvm.func @llvm.xpu.sync_core(i32) attributes {passthrough = ["convergent", "noduplicate"]}\n  llvm.func @llvm.xpu.xfence()\n  llvm.func @llvm.xpu.mfence.v2(i32)',
+            1)
+    return changed, records
+
+
+def lower(mod, directory, options):
+    if not supported_launch(options):
+        return mod, []  # Preserve original lowering for a non-eight-core launch.
+    from ._p800_native_activation import serialize, parse
+    source = serialize(mod, directory, 'before_parallel_rne')
+    changed, records = rewrite(source)
+    if not records:
+        return mod, records
+    return parse(mod, changed, Path(directory) / 'parallel-rne.mlir'), records
diff --git a/python/triton/experimental/graph_fusion/_p800_precision.py b/python/triton/experimental/graph_fusion/_p800_precision.py
new file mode 100644
index 000000000..ffd1fd760
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_p800_precision.py
@@ -0,0 +1,165 @@
+"""Generic P800 scalar legalization and BF16 rounding.
+
+No matrix code, tiling or launch template is supplied.
+"""
+import re
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+import hashlib
+import os
+import json
+import tempfile
+from pathlib import Path
+
+_ACTIVE = ContextVar("flagtree_p800_precision", default=False)
+
+
+def preserve_bf16_rounding(mod, special_values=True):
+    from triton._C.libtriton import ir, passes
+    import triton.language as tl
+    exact_values = set()
+
+    def classify(op):
+        if op.get_name() == 'arith.maxnumf' and op.get_bool_attr('f06.bf16_exact'):
+            exact_values.add(op.get_result(0).id())
+
+    mod.walk(classify)
+    casts = []
+    mod.walk(lambda op: casts.append(op) if op.get_name() == 'arith.truncf' else None)
+    rewritten = []
+    for op in casts:
+        source, dest = op.get_operand(0), op.get_result(0)
+        if source.id() in exact_values:
+            continue  # ReLU of an already BF16 value is exactly representable.
+        src, dst = str(source.get_type()), str(dest.get_type())
+        shape = re.fullmatch(r'tensor<((?:[0-9]+x)+)f32>', src)
+        if not shape or dst != src.replace('f32>', 'bf16>'):
+            continue
+        dims = [int(x) for x in shape[1].rstrip('x').split('x')]
+        b = ir.builder(mod.context)
+        b.set_insertion_point_after(op)
+        u32 = tl.block_type(tl.uint32, dims).to_ir(b)
+
+        def constant(value):
+            return b.create_splat(u32, b.get_uint32(value))
+
+        bits = b.create_bitcast(source, u32)
+        odd = b.create_and(b.create_lshr(bits, constant(16)), constant(1))
+        rounded = b.create_and(b.create_add(b.create_add(bits, constant(0x7FFF)), odd), constant(0xFFFF0000))
+        if special_values:
+            magnitude = b.create_and(bits, constant(0x7FFFFFFF))
+            is_special = b.create_icmpUGE(magnitude, constant(0x7F800000))
+            is_nan = b.create_icmpUGT(magnitude, constant(0x7F800000))
+            quiet_nan = b.create_or(bits, constant(0x00400000))
+            special = b.create_select(is_nan, quiet_nan, bits)
+            rounded = b.create_select(is_special, special, rounded)
+        rounded_float = b.create_bitcast(rounded, source.get_type())
+        new_cast = b.create_fp_trunc(rounded_float, dest.get_type())
+        dest.replace_all_uses_with(new_cast)
+        rewritten.append({'source': src, 'destination': dst})
+    pm = ir.pass_manager(mod.context)
+    passes.common.add_canonicalizer(pm)
+    passes.common.add_cse(pm)
+    pm.run(mod, 'after_bf16_rounding')
+    assert mod.verify()
+    return rewritten
+
+
+@contextmanager
+def _compilation_scope():
+    """Scope the passes to one serialized P800 compilation.
+
+    The caller holds the existing native-template compile lock. Use an isolated
+    Triton cache and force compilation because the pass is not in backend.hash.
+    """
+    from triton.backends.xpu.compiler import XPUBackend
+    from triton._C.libtriton import xpu
+    original = XPUBackend.make_ttir
+    original_table = XPUBackend.make_ewtable
+    original_llir = XPUBackend.make_llir
+    from ._p800_division import split_division_rows
+    from ._p800_activation import lower_scalar_ops
+    from ._p800_tables import make_ewtable
+    keys = ('TRITON_CACHE_DIR', 'TRITON_ALWAYS_COMPILE')
+    saved = {key: os.environ.get(key) for key in keys}
+    cache = saved['TRITON_CACHE_DIR']
+    if not cache:
+        from triton import knobs
+        cache = knobs.cache.dir
+    digest = hashlib.sha256(b''.join(
+        (Path(__file__).parent / name).read_bytes()
+        for name in ('_p800_precision.py', '_p800_activation.py', '_p800_tables.py', '_p800_division.py',
+                     '_p800_native_activation.py', '_p800_parallel_rne.py'))).hexdigest()[:16]
+
+    def make_ttir(mod, metadata, options):
+        mod = original(mod, metadata, options)
+        if not _ACTIVE.get() or options.arch != 3:
+            return mod
+        if not (options.is_sdnn or xpu.is_sdnn_kernel(mod)):
+            from ._p800_native_activation import bound_tanh_inputs
+            with tempfile.TemporaryDirectory(prefix='cluster-tanh-', dir=os.environ['TRITON_CACHE_DIR']) as directory:
+                mod, records = bound_tanh_inputs(mod, directory, triton_bitcast=True)
+            for record in records:
+                record['scope'] = 'native cluster f32 tanh input/output'
+            metadata['cluster_tanh_bounds'] = json.dumps(records)
+            metadata['cluster_rounding_rewrites'] = json.dumps(preserve_bf16_rounding(mod, special_values=True))
+            return mod
+        from ._p800_native_activation import prepare
+        mod = prepare(mod, metadata)
+        lower_scalar_ops(mod, clamp_max=False)
+        preserve_bf16_rounding(mod, special_values=True)
+        return mod
+
+    def make_llir(mod, metadata, options):
+        if _ACTIVE.get() and options.arch == 3 and metadata.get('is_sdnn'):
+            with tempfile.TemporaryDirectory(prefix='division-', dir=os.environ['TRITON_CACHE_DIR']) as directory:
+                from ._p800_parallel_rne import lower
+                mod, parallel = lower(mod, directory, options)
+                metadata["parallel_rne"] = json.dumps(parallel)
+                mod, repairs = split_division_rows(mod, directory)
+                if parallel:
+                    from ._p800_native_activation import serialize
+                    text = serialize(mod, directory, "parallel_rne_final")
+                    identity = hashlib.sha256(text.encode()).hexdigest()
+                    audit = Path(os.environ["TRITON_CACHE_DIR"]) / "parallel-ir"
+                    audit.mkdir(parents=True, exist_ok=True)
+                    (audit / (identity + ".mlir")).write_text(text)
+                    metadata["parallel_rne_ir_sha256"] = identity
+            metadata['division_row_repair'] = json.dumps(repairs)
+        return original_llir(mod, metadata, options)
+
+    def table(mod, metadata, options):
+        return make_ewtable(mod, metadata, options) if _ACTIVE.get() and options.arch == 3 else original_table(
+            mod, metadata, options)
+
+    XPUBackend.make_llir = staticmethod(make_llir)
+    XPUBackend.make_ttir = staticmethod(make_ttir)
+    XPUBackend.make_ewtable = staticmethod(table)
+    os.environ['TRITON_CACHE_DIR'] = cache + '-p800-ops-' + digest
+    os.environ['TRITON_ALWAYS_COMPILE'] = '1'
+    try:
+        yield
+    finally:
+        XPUBackend.make_llir = staticmethod(original_llir)
+        XPUBackend.make_ttir = staticmethod(original)
+        XPUBackend.make_ewtable = staticmethod(original_table)
+        for key, value in saved.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
+                os.environ[key] = value
+
+
+@contextmanager
+def compilation_scope():
+    from torch._dynamo.convert_frame import compile_lock
+    with compile_lock:
+        if _ACTIVE.get():
+            raise RuntimeError("nested P800 precision compilation is unsupported")
+        token = _ACTIVE.set(True)
+        try:
+            with _compilation_scope():
+                yield
+        finally:
+            _ACTIVE.reset(token)
diff --git a/python/triton/experimental/graph_fusion/_p800_tables.py b/python/triton/experimental/graph_fusion/_p800_tables.py
new file mode 100644
index 000000000..9d6661bbc
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_p800_tables.py
@@ -0,0 +1,56 @@
+"""Supply native SDNN lookup functions, without GEMM code."""
+import hashlib
+import json
+from pathlib import Path
+
+
+def make_ewtable(mod, metadata, opt):
+    import numpy as np
+    import torch
+    from triton._C.libtriton import xpu
+    from triton.runtime.cache import get_cache_manager
+    info_map = xpu.get_lut_info(mod)
+    metadata['ewtable'] = ''
+    if not info_map:
+        return mod
+    functions = {
+        'math.exp': np.exp,
+        'math.exp2': np.exp2,
+        'math.log2': np.log2,
+        'tt.gelu': lambda x: torch.nn.functional.gelu(torch.tensor(x)).item(),
+        'tt.tanh': np.tanh,
+        # Native sigmoid instructions implement 0.5 * tanh(x/2) + 0.5 and
+        # therefore consume a tanh table, not a logistic table.
+        'tt.sigmoid': np.tanh,
+    }
+    records = [(name, i.dtype, i.mode, i.size, i.min, i.interval) for name, i in info_map.items()]
+    digest = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    key = hashlib.sha256(json.dumps((digest, records)).encode()).hexdigest()
+    cache = get_cache_manager(key)
+    name = 'activation_ewtable.dat'
+    cached = cache.get_file(name)
+    if cached is None:
+        ks, bs = b'', b''
+        for name, dtype, mode, size, lower, interval in records:
+            fn = functions[name]
+            table = [0.0] * (size * 2)
+            if mode == 0:
+                values = [fn(lower + i * interval) for i in range(size + 1)]
+                for i in range(size):
+                    table[i] = (values[i + 1] - values[i]) / interval
+                    table[i + size] = values[i] - table[i] * (lower + i * interval)
+            else:
+                # Preserve the native backend's current interpolation layout.
+                # Its exp-specific refinement branch is unreachable after fn
+                # becomes callable; do not silently alter it in this candidate.
+                values = [fn(lower + i * interval) for i in range(2 * (size + 1))]
+                for i in range(size):
+                    table[i], table[i + size] = values[2 * i], values[2 * i + 1]
+            data = np.array(table, dtype={0: np.float32, 1: np.float16}[dtype]).tobytes()
+            mid = len(data) // 2
+            ks += data[:mid]
+            bs += data[mid:]
+        cached = cache.put(ks + bs, 'activation_ewtable.dat', binary=True)
+    metadata['ewtable'] = cached
+    metadata['activation_lut_diagnostic'] = json.dumps(records)
+    return mod
diff --git a/python/triton/experimental/graph_fusion/_resource_codegen.py b/python/triton/experimental/graph_fusion/_resource_codegen.py
new file mode 100644
index 000000000..8573b107f
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_resource_codegen.py
@@ -0,0 +1,375 @@
+"""Attach a resource request to compiler-generated kernels, not their math.
+
+Experimental Torch 2.5 bridge. The native Inductor heuristic factory, generated
+function body and native configs remain unchanged. Scoped P800 backend repairs
+are implemented separately in _p800_compiler and its lowering helpers.
+"""
+import ast
+from contextlib import contextmanager
+from contextvars import ContextVar
+import hashlib
+import threading
+
+_REQUEST = ContextVar("flagtree_inductor_resource", default=None)
+_SCALAR_REDUCTION = ContextVar("flagtree_p800_scalar_reduction", default=False)
+_LOCK = threading.RLock()
+_EVIDENCE = []
+_FACTORIES = frozenset(("pointwise", "reduction", "persistent_reduction", "split_scan", "template", "foreach"))
+
+
+def baidu_target():
+    """Do not confuse the vendor's CUDA alias with an NVIDIA device."""
+    try:
+        import triton
+        driver = triton.runtime.driver.active
+    except (ImportError, RuntimeError, AttributeError):
+        return None
+    cls = type(driver)
+    if cls.__module__ != "triton.backends.xpu.driver" or cls.__name__ != "XPUDriver":
+        return None
+    target = driver.get_current_target()
+    if type(target.arch) is not int or target.arch not in (2, 3, 4, 5):
+        return None
+    return {
+        "driver": cls.__module__ + "." + cls.__name__, "arch": target.arch, "warp_size": target.warp_size,
+        "backend_alias": target.backend
+    }
+
+
+def _inspection_tree(source):
+    # Native codegen has not yet substituted its final function name here.
+    # Normalize only the AST inspection copy, leaving the generated text and
+    # all computation intact for Inductor's own later name substitution.
+    return ast.parse(source.replace('def Placeholder.KERNEL_NAME(', 'def __flagtree_inspection_kernel('))
+
+
+def _function_bodies(source):
+    return [
+        ast.dump(ast.Module(body=n.body, type_ignores=[]), include_attributes=False)
+        for n in _inspection_tree(source).body
+        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
+    ]
+
+
+def annotate_source(source, resource):
+    if resource not in ("cluster", "sdnn"):
+        raise ValueError("explicit Cluster or SDNN resource required")
+    before = _function_bodies(source)
+    tree = _inspection_tree(source)
+    factories = []
+    for n in tree.body:
+        if not isinstance(n, ast.FunctionDef):
+            continue
+        for decorator in n.decorator_list:
+            if (isinstance(decorator, ast.Call) and isinstance(decorator.func, ast.Attribute)
+                    and isinstance(decorator.func.value, ast.Name) and decorator.func.value.id == "triton_heuristics"):
+                if decorator.func.attr not in _FACTORIES:
+                    raise RuntimeError("unsupported native heuristic: " + decorator.func.attr)
+                factories.append(decorator.func.attr)
+    if not factories:
+        raise RuntimeError("no native Inductor heuristic in generated kernel")
+    # The generated function body is left byte-for-byte intact. An explicit
+    # resource literal in the generated module also separates code-cache keys.
+    prefix = ("from triton.experimental.graph_fusion._resource_codegen import ResourceHeuristics\n"
+              "_flagtree_resource_heuristics = ResourceHeuristics(" + repr(resource) + ")\n")
+    from ._p800_compiler import policy_key
+    prefix += "# P800 compiler policy: " + policy_key() + "\n"
+    changed = source
+    for name in set(factories):
+        changed = changed.replace("@triton_heuristics." + name + "(", "@_flagtree_resource_heuristics." + name + "(")
+    changed = prefix + changed
+    if _function_bodies(changed) != before:
+        raise RuntimeError("resource annotation changed generated computation")
+    return changed
+
+
+def _record_binary(binary, requested):
+    meta = binary.metadata
+    actual = "sdnn" if meta.is_sdnn else "cluster"
+    # Deployed legacy P800 binaries expose is_sdnn but not resource_kind.
+    # Still require an actual boolean; never infer resource from the request.
+    if (type(meta.is_sdnn) is not bool or actual != requested
+            or getattr(meta, "resource_kind", requested if getattr(meta, "arch", None) == 3 else None) != requested):
+        raise RuntimeError("compiled resource metadata does not match request")
+    entry = {
+        "requested": requested, "effective": actual, "kernel_name": meta.name, "binary_hash":
+        str(getattr(binary, "hash", "")), "launch_clusters": getattr(meta, "launch_clusters", None), "launch_cores":
+        getattr(meta, "launch_cores", None), "asm_sha256": {
+            name: hashlib.sha256(value if isinstance(value, bytes) else str(value).encode()).hexdigest()
+            for name, value in binary.asm.items()
+        }
+    }
+    _EVIDENCE.append(entry)
+    return entry
+
+
+def _bound_kernel_evidence(compiled, resource):
+    """Inspect binaries actually bound by the wrapper, also on cache reuse.
+
+    A cache hit need not call _precompile_config again. Conversely, newly
+    benchmarked candidates do not prove which binaries the final wrapper uses.
+    """
+    from pathlib import Path
+    from torch._inductor.codecache import PyCodeCache
+    module = PyCodeCache.cache.get(compiled.cache_key)
+    if module is None or Path(module.__file__).read_text() != compiled.source_code:
+        raise RuntimeError("native wrapper cache/source identity could not be verified")
+    proofs = []
+    for node in ast.walk(ast.parse(compiled.source_code)):
+        if not (isinstance(node, ast.Assign) and isinstance(node.value, ast.Call)
+                and ast.unparse(node.value.func) == 'async_compile.triton'):
+            continue
+        if len(node.targets) != 1 or not isinstance(node.targets[0], ast.Name):
+            raise RuntimeError('unknown native kernel binding')
+        name = node.targets[0].id
+        tuner = getattr(module, name)
+        tuner.precompile()
+        if not tuner.launchers:
+            raise RuntimeError('native kernel has no compiled launcher')
+        for launcher in tuner.launchers:
+            binary = getattr(launcher, '__globals__', {}).get('bin')
+            if binary is None:
+                raise RuntimeError('native launcher lacks its bound compiled binary')
+            entry = dict(_record_binary(binary, resource))
+            entry.update(wrapper_binding=name,
+                         source_sha256=hashlib.sha256(node.value.args[1].value.encode()).hexdigest(),
+                         proof_scope='bound_native_wrapper_binary')
+            proofs.append(entry)
+    return proofs
+
+
+class ResourceHeuristics:
+
+    def __init__(self, resource):
+        if resource not in ("cluster", "sdnn"):
+            raise ValueError("unknown resource")
+        self.resource = resource
+
+    def __getattr__(self, name):
+        if name not in _FACTORIES:
+            raise AttributeError(name)
+        from torch._inductor.runtime import triton_heuristics
+        original = getattr(triton_heuristics, name)
+        resource = self.resource
+
+        def factory(*args, **kwargs):
+            decorate = original(*args, **kwargs)
+
+            def wrapped(fn):
+                tuner = decorate(fn)
+                compile_config = tuner._precompile_config
+
+                def compile_for_resource(*a, **kw):
+                    target = baidu_target()
+                    if target and target['arch'] == 3 and target['warp_size'] == 1:
+                        from ._p800_compiler import resource_scope
+                    else:
+                        from triton.backends.xpu.resource_context import resource_scope
+                    with resource_scope(resource):
+                        result = compile_config(*a, **kw)
+                    binary = result[0] if isinstance(result, tuple) else result
+                    _record_binary(binary, resource)
+                    return result
+
+                tuner._precompile_config = compile_for_resource
+                return tuner
+
+            return wrapped
+
+        return factory
+
+
+def _annotate_partial_render(rendered, resource):
+    """Cover native autotune rendering and native final epilogue rendering."""
+    finalize = rendered.finalize_all
+    finalize_hook = rendered.finalize_hook
+    annotated = False
+
+    def finalize_resource():
+        return annotate_source(finalize(), resource)
+
+    def finalize_hook_resource(*args, **kwargs):
+        nonlocal annotated
+        result = finalize_hook(*args, **kwargs)
+        # The final template path reads .code after individual hooks, without
+        # calling finalize_all. Wait until every native substitution finishes.
+        if not annotated and all(fn is None for fn in rendered.replacement_hooks.values()):
+            rendered.code = annotate_source(rendered.code, resource)
+            annotated = True
+        return result
+
+    rendered.finalize_all = finalize_resource
+    rendered.finalize_hook = finalize_hook_resource
+    return rendered
+
+
+@contextmanager
+def generated_resource(resource, *, native_template_eligibility=False, scalar_reduction=False):
+    if resource not in ("cluster", "sdnn"):
+        raise ValueError("explicit resource required")
+    if baidu_target() is None:
+        raise RuntimeError("resource routing requires positively identified Baidu XPU backend")
+    if _REQUEST.get() is not None:
+        raise RuntimeError("nested resource compilation is unsupported")
+    from torch._inductor.codegen.triton import TritonKernel
+    from torch._inductor.select_algorithm import TritonTemplateKernel
+    from torch._inductor.select_algorithm import AlgorithmSelectorCache
+    from torch._inductor import config
+    from torch._inductor import utils
+    from torch._dynamo.convert_frame import compile_lock
+    # Scoped codegen change is context-local for unrelated compiler threads;
+    # explicit resource decorators survive async module loading. Disable the
+    # graph cache so a previously compiled unannotated graph cannot bypass this.
+    # Share Dynamo's compilation lock so temporary native config settings do
+    # not leak into a concurrent torch.compile callback on another thread.
+    with compile_lock, _LOCK:
+        original = TritonKernel.codegen_kernel
+        original_no_x = TritonKernel.want_no_x_dim
+        original_render = TritonTemplateKernel.render
+        original_big_gpu = utils.is_big_gpu
+        original_select = AlgorithmSelectorCache.__call__
+        token = _REQUEST.set(resource)
+        reduction_token = _SCALAR_REDUCTION.set(scalar_reduction)
+        target = baidu_target()
+        repair_reduction = target['arch'] == 3 and target['warp_size'] == 1
+
+        def select_algorithm(selector, *args, **kwargs):
+            # Torch 2.5's GEMM selector has a separate precompilation thread
+            # pool, even with compile_threads=1. Waiting for that pool while
+            # holding Dynamo's compile lock deadlocks the resource decorator.
+            # Skip only speculative parallel precompilation: native candidate
+            # benchmarking/selection still compiles synchronously as needed.
+            if repair_reduction and _REQUEST.get() is not None:
+                import inspect
+                bound = inspect.signature(original_select).bind(selector, *args, **kwargs)
+                if 'precompilation_timeout_seconds' not in inspect.signature(original_select).parameters:
+                    raise RuntimeError('P800 native precompilation API is unavailable')
+                bound.arguments['precompilation_timeout_seconds'] = 0
+                return original_select(*bound.args, **bound.kwargs)
+            return original_select(selector, *args, **kwargs)
+
+        AlgorithmSelectorCache.__call__ = select_algorithm
+
+        def want_no_x_dim(kernel):
+            # Keep native 2D reduction layout: the P800 rank-1 lowering writes
+            # the scalar result from every core. Native 2D writeback predicates
+            # the owning core. No tiling or generated arithmetic is supplied.
+            if repair_reduction and _REQUEST.get() == 'cluster' and _SCALAR_REDUCTION.get():
+                return False
+            return original_no_x(kernel)
+
+        TritonKernel.want_no_x_dim = want_no_x_dim
+        if native_template_eligibility:
+            # P800 exposes 8 units through the CUDA alias. Native Torch 2.5's
+            # >=68 NVIDIA SM heuristic otherwise suppresses every GEMM template.
+            # This only admits native candidates for this identified backend;
+            # their configs, generated math and backend validation stay native.
+            def eligible(index):
+                return True if _REQUEST.get() == resource else original_big_gpu(index)
+
+            utils.is_big_gpu = eligible
+
+        def codegen(kernel, *args, **kwargs):
+            code = original(kernel, *args, **kwargs)
+            requested = _REQUEST.get()
+            return annotate_source(code, requested) if requested else code
+
+        TritonKernel.codegen_kernel = codegen
+
+        def render(kernel, *args, **kwargs):
+            rendered = original_render(kernel, *args, **kwargs)
+            requested = _REQUEST.get()
+            return _annotate_partial_render(rendered, requested) if requested else rendered
+
+        TritonTemplateKernel.render = render
+        try:
+            with config.patch({"compile_threads": 1, "fx_graph_cache": False, "fx_graph_remote_cache": False}):
+                yield
+        finally:
+            if AlgorithmSelectorCache.__call__ is select_algorithm:
+                AlgorithmSelectorCache.__call__ = original_select
+            if TritonKernel.want_no_x_dim is want_no_x_dim:
+                TritonKernel.want_no_x_dim = original_no_x
+            if native_template_eligibility and utils.is_big_gpu is eligible:
+                utils.is_big_gpu = original_big_gpu
+            if TritonKernel.codegen_kernel is codegen:
+                TritonKernel.codegen_kernel = original
+            if TritonTemplateKernel.render is render:
+                TritonTemplateKernel.render = original_render
+            _REQUEST.reset(token)
+            _SCALAR_REDUCTION.reset(reduction_token)
+
+
+def evidence():
+    return list(_EVIDENCE)
+
+
+def audit_wrapper(source, resource):
+    """Fail closed if a generated kernel or external operation is unaccounted."""
+    tree = ast.parse(source)
+    kernels = []
+    external = []
+    for n in ast.walk(tree):
+        if not isinstance(n, ast.Call):
+            continue
+        target = ast.unparse(n.func)
+        if target == "async_compile.triton":
+            if len(n.args) < 2 or not isinstance(n.args[1], ast.Constant) or not isinstance(n.args[1].value, str):
+                raise RuntimeError("unrecognized native generated kernel source")
+            code = n.args[1].value
+            expected = "ResourceHeuristics(" + repr(resource) + ")"
+            if expected not in code or "@triton_heuristics." in code:
+                raise RuntimeError("generated kernel is missing its explicit resource")
+            kernels.append(hashlib.sha256(code.encode()).hexdigest())
+        elif target.startswith(("extern_kernels.", "torch.ops.", "aten.", "ops.")):
+            external.append(target)
+    return {"generated_kernel_sources": kernels, "external_call_targets": external}
+
+
+def compile_region(gm, inputs, resource, *, matmul_path="external"):
+    """Use native decomposition and Inductor; caller validates the result.
+
+    External-library calls remain a hard, unverified boundary. They are not
+    assigned SDNN based on an operator name. The optional template path uses
+    native Inductor templates/configs, without editing generated computation.
+    """
+    from torch._inductor.compile_fx import compile_fx_inner, BoxedBool
+    from torch._inductor.decomposition import select_decomp_table
+    from torch.fx.experimental.proxy_tensor import make_fx
+    from torch._inductor import config
+    import torch
+    if torch.cuda.is_initialized() and torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("resource compilation/autotuning must finish before graph capture")
+    if matmul_path not in ("external", "template"):
+        raise ValueError("matmul_path must be external or template")
+    output = next(n for n in gm.graph.nodes if n.op == "output")
+    if not isinstance(output.args[0], tuple):
+        raise ValueError("region graph output must be a tuple")
+    lowered = make_fx(gm, decomposition_table=select_decomp_table(), tracing_mode="fake",
+                      _allow_non_fake_inputs=True)(*inputs)
+    # Explicitly select native candidates; never alter math precision flags or
+    # hand-pick tile/warp configs. Autotuning is offline, before graph capture.
+    options = {
+        "max_autotune_gemm": matmul_path == "template", "max_autotune_gemm_backends":
+        "TRITON" if matmul_path == "template" else "ATEN", "max_autotune": False, "autotune_in_subproc": False
+    }
+    # Only scalar-output reductions need the P800 ownership repair. Softmax
+    # and LayerNorm write full rows and should keep native reduction layouts.
+    output_node = next(n for n in lowered.graph.nodes if n.op == 'output')
+    outputs = output_node.args[0]
+    scalar_reduction = (any(n.target == torch.ops.aten.sum.dim_IntList for n in lowered.graph.nodes) and all(
+        isinstance(n, torch.fx.Node) and isinstance(n.meta.get('val'), torch.Tensor) and n.meta['val'].numel() < max(
+            (x.numel() for x in inputs if isinstance(x, torch.Tensor)), default=0) for n in outputs))
+    with generated_resource(resource, native_template_eligibility=matmul_path == "template",
+                            scalar_reduction=scalar_reduction), config.patch(options):
+        compiled = compile_fx_inner(lowered, list(inputs), is_inference=True, cudagraphs=BoxedBool(False))
+    source = compiled.source_code
+    wrapper_audit = audit_wrapper(source, resource)
+    external = len(wrapper_audit['external_call_targets'])
+    bound_evidence = _bound_kernel_evidence(compiled, resource)
+    return compiled, {
+        "resource": resource, "matmul_path": matmul_path, "scalar_reduction_layout": scalar_reduction,
+        "native_template_eligibility": matmul_path == "template", "wrapper_audit": wrapper_audit, "external_calls":
+        external, "kernel_evidence": bound_evidence, "source_code": source, "resource_verified": external == 0
+        and bool(wrapper_audit['generated_kernel_sources']) and bool(bound_evidence)
+    }
diff --git a/python/triton/experimental/graph_fusion/_resource_fx.py b/python/triton/experimental/graph_fusion/_resource_fx.py
new file mode 100644
index 000000000..f66c5b135
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_resource_fx.py
@@ -0,0 +1,815 @@
+"""Offline FX subgraph construction and execution glue for resource planning.
+
+This module is experimental scheduling/calibration glue only.  It copies and
+executes existing pure FX nodes; it does not generate kernels, autotune, supply
+runtime guards, or claim production certification.  A parent integration using
+``torch.compile`` remains responsible for its native guards and full-plan
+end-to-end numerical/performance validation.
+
+All helpers reject autograd tensors. Offline example collection refuses device
+graph capture; metadata and prepared execution support CPU, GPU and fake tensors.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import operator
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+import torch.fx
+import torch.nn.functional as F
+from torch.fx.node import map_arg
+
+from torch.fx.immutable_collections import (
+    immutable_dict as _FxImmutableDict,
+    immutable_list as _FxImmutableList,
+)
+
+from ._resource_planner import PartitionPlan
+
+try:
+    from torch._ops import OpOverload as _OpOverload
+except Exception:  # pragma: no cover - defensive for unusual Torch builds
+    _OpOverload = ()  # type: ignore[assignment]
+
+__all__ = [
+    "PartitionExecutionError",
+    "Region",
+    "UnsupportedGraph",
+    "build_all_regions",
+    "build_region",
+    "collect_example_values",
+    "context_fingerprint",
+    "execute_partition",
+]
+
+_MAX_COMPUTE_NODES = 16
+_ALLOWED_METHODS = frozenset({
+    "add",
+    "mul",
+    "div",
+    "truediv",
+    "matmul",
+    "mm",
+    "sum",
+    "amax",
+    "exp",
+    "relu",
+    "clone",
+    "softmax",
+})
+_ALLOWED_ATEN_OVERLOADS = frozenset({
+    ("add", "Tensor"),
+    ("add", "Scalar"),
+    ("mul", "Tensor"),
+    ("mul", "Scalar"),
+    ("div", "Tensor"),
+    ("div", "Scalar"),
+    ("matmul", "default"),
+    ("mm", "default"),
+    ("sum", "default"),
+    ("sum", "dim_IntList"),
+    ("amax", "default"),
+    ("exp", "default"),
+    ("relu", "default"),
+    ("clone", "default"),
+    ("softmax", "int"),
+    ("gelu", "default"),
+    ("silu", "default"),
+    ("layer_norm", "default"),
+})
+
+
+def _optional_function(owner: Any, name: str) -> Any:
+    try:
+        return getattr(owner, name)
+    except AttributeError:
+        return None
+
+
+_C_NN = getattr(torch._C, "_nn", None)
+_candidate_targets = [
+    torch.add,
+    torch.mul,
+    torch.div,
+    torch.matmul,
+    torch.mm,
+    torch.sum,
+    torch.amax,
+    torch.exp,
+    torch.relu,
+    torch.clone,
+    torch.softmax,
+    operator.add,
+    operator.mul,
+    operator.truediv,
+    operator.matmul,
+    F.relu,
+    F.gelu,
+    F.silu,
+    F.softmax,
+    F.layer_norm,
+    getattr(torch, "truediv", None),
+    _optional_function(_C_NN, "gelu"),
+    _optional_function(_C_NN, "silu"),
+    _optional_function(_C_NN, "layer_norm"),
+]
+_ALLOWED_FUNCTION_TARGETS = frozenset(target for target in _candidate_targets if target is not None)
+
+
+class UnsupportedGraph(Exception):
+    """The FX graph or an offline value is outside the supported pure contract."""
+
+
+class PartitionExecutionError(ValueError):
+    """A plan, compiled-region map, or region output is inconsistent."""
+
+
+@dataclass(frozen=True)
+class Region:
+    """A standalone FX subgraph for one contiguous compute-node interval.
+
+    ``gm`` has placeholders in ``input_names`` order and always returns a tuple
+    of boundary values in ``output_names`` order.  Live get_attr values are not
+    embedded; callers supply them as inputs on every invocation.
+    """
+
+    gm: torch.fx.GraphModule
+    input_names: tuple[str, ...]
+    output_names: tuple[str, ...]
+    start: int
+    end: int
+    node_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class _GraphInfo:
+    gm: torch.fx.GraphModule
+    nodes: tuple[torch.fx.Node, ...]
+    node_index: dict[torch.fx.Node, int]
+    compute_nodes: tuple[torch.fx.Node, ...]
+    compute_ids: tuple[str, ...]
+    placeholders: tuple[torch.fx.Node, ...]
+    get_attrs: tuple[torch.fx.Node, ...]
+    output_node: torch.fx.Node
+    output_structure: Any
+
+
+class _RecordingInterpreter(torch.fx.Interpreter):
+
+    def __init__(self, module: torch.fx.GraphModule) -> None:
+        super().__init__(module)
+        self.values: dict[str, Any] = {}
+
+    def run_node(self, node: torch.fx.Node) -> Any:
+        result = super().run_node(node)
+        self.values[node.name] = result
+        return result
+
+
+def _aten_parts(target: Any) -> tuple[str, str] | None:
+    if not isinstance(target, _OpOverload):
+        return None
+    schema = getattr(target, "_schema", None)
+    full_name = getattr(schema, "name", None)
+    overload_name = getattr(target, "__name__", None)
+    if not isinstance(full_name, str) or not isinstance(overload_name, str):
+        return None
+    base_name = full_name.split("::")[-1]
+    if "." in overload_name:
+        overload = overload_name.split(".", 1)[1]
+    else:
+        overload = ""
+    return base_name, overload
+
+
+def _is_supported_function(target: Any) -> bool:
+    aten = _aten_parts(target)
+    if aten is not None:
+        return aten in _ALLOWED_ATEN_OVERLOADS
+    try:
+        return target in _ALLOWED_FUNCTION_TARGETS
+    except TypeError:
+        return False
+
+
+def _target_identity(target: Any) -> str:
+    aten = _aten_parts(target)
+    if aten is not None:
+        module = getattr(target, "__module__", None)
+        name = getattr(target, "__name__", None)
+        if not isinstance(module, str) or not isinstance(name, str):
+            raise UnsupportedGraph("aten target has no stable identity")
+        return f"{module}.{name}"
+    module = getattr(target, "__module__", None)
+    qualname = getattr(target, "__qualname__", None) or getattr(target, "__name__", None)
+    if not isinstance(module, str) or not isinstance(qualname, str):
+        raise UnsupportedGraph("call target has no stable module/qualname identity")
+    return f"{module}.{qualname}"
+
+
+def _validate_call_target(node: torch.fx.Node) -> None:
+    kwargs = node.kwargs
+    if not isinstance(kwargs, Mapping):
+        raise UnsupportedGraph(f"{node.name!r}: call kwargs are not a mapping")
+    if "out" in kwargs:
+        raise UnsupportedGraph(f"{node.name!r}: out= call variants/mutations are unsupported")
+    if "inplace" in kwargs and kwargs["inplace"] is not False:
+        raise UnsupportedGraph(f"{node.name!r}: inplace=True mutations are unsupported")
+
+    if node.op == "call_method":
+        target = node.target
+        if not isinstance(target, str):
+            raise UnsupportedGraph(f"{node.name!r}: method target is not a string")
+        if target.endswith("_") or target not in _ALLOWED_METHODS:
+            raise UnsupportedGraph(f"{node.name!r}: unsupported or mutating tensor method {target!r}")
+        return
+
+    if node.op != "call_function":
+        raise UnsupportedGraph(f"{node.name!r}: unsupported call node kind")
+    if not callable(node.target):
+        raise UnsupportedGraph(f"{node.name!r}: call target is not callable")
+
+    aten = _aten_parts(node.target)
+    target_name = getattr(node.target, "__name__", None)
+    if aten is not None:
+        base_name, overload = aten
+        if base_name.endswith("_") or "out" in overload:
+            raise UnsupportedGraph(f"{node.name!r}: inplace/out aten overloads are unsupported")
+    elif isinstance(target_name, str) and target_name.endswith("_"):
+        raise UnsupportedGraph(f"{node.name!r}: inplace/out function targets are unsupported")
+    if not _is_supported_function(node.target):
+        safe_target = (_target_identity(node.target) if aten is None else f"aten.{aten[0]}.{aten[1]}")
+        raise UnsupportedGraph(f"{node.name!r}: unsupported or side-effecting call target "
+                               f"{safe_target!r}")
+
+
+def _analyze_graph(gm: torch.fx.GraphModule) -> _GraphInfo:
+    if not isinstance(gm, torch.fx.GraphModule):
+        raise TypeError("gm must be a torch.fx.GraphModule")
+
+    nodes = tuple(gm.graph.nodes)
+    for node in nodes:
+        if node.op == "call_module":
+            raise UnsupportedGraph(f"{node.name!r}: call_module is unsupported; trace pure functions")
+        if node.op not in (
+                "placeholder",
+                "get_attr",
+                "call_function",
+                "call_method",
+                "output",
+        ):
+            raise UnsupportedGraph(f"{node.name!r}: unsupported FX node kind {node.op!r}")
+
+    compute_nodes = tuple(node for node in nodes if node.op in ("call_function", "call_method"))
+    if len(compute_nodes) > _MAX_COMPUTE_NODES:
+        raise UnsupportedGraph(f"graph has {len(compute_nodes)} compute nodes; "
+                               f"offline enumeration supports at most {_MAX_COMPUTE_NODES}")
+    if not compute_nodes:
+        raise UnsupportedGraph("graph has no call_function/call_method compute nodes")
+
+    output_nodes = [node for node in nodes if node.op == "output"]
+    if len(output_nodes) != 1 or nodes[-1].op != "output":
+        raise UnsupportedGraph("graph must have exactly one final output node")
+    output_node = output_nodes[0]
+    if len(output_node.args) != 1:
+        raise UnsupportedGraph("graph output must contain one output structure")
+
+    for node in nodes:
+        if node.op in ("call_function", "call_method"):
+            _validate_call_target(node)
+        elif node.op in ("placeholder", "get_attr"):
+            if not isinstance(node.target, str) or not node.target:
+                raise UnsupportedGraph(f"{node.name!r}: {node.op} target must be a nonempty string")
+
+    for node in compute_nodes:
+        if not node.users:
+            raise UnsupportedGraph(f"{node.name!r}: dead compute nodes are unsupported; "
+                                   "every compute node must reach an outside use or final output")
+
+    node_index = {node: index for index, node in enumerate(nodes)}
+    placeholders = tuple(node for node in nodes if node.op == "placeholder")
+    get_attrs = tuple(node for node in nodes if node.op == "get_attr")
+    return _GraphInfo(
+        gm=gm,
+        nodes=nodes,
+        node_index=node_index,
+        compute_nodes=compute_nodes,
+        compute_ids=tuple(node.name for node in compute_nodes),
+        placeholders=placeholders,
+        get_attrs=get_attrs,
+        output_node=output_node,
+        output_structure=output_node.args[0],
+    )
+
+
+def _validate_interval(start: int, end: int, node_count: int) -> None:
+    if (isinstance(start, bool) or not isinstance(start, int) or isinstance(end, bool) or not isinstance(end, int)):
+        raise TypeError("region start/end must be integer positional indices")
+    if start < 0 or end > node_count:
+        raise ValueError(f"region [{start}, {end}) is outside [0, {node_count})")
+    if start >= end:
+        raise ValueError(f"region [{start}, {end}) is empty; empty regions are unsupported")
+
+
+def _boundary_outputs(
+    interval_nodes: tuple[torch.fx.Node, ...],
+    interval: frozenset[torch.fx.Node],
+) -> tuple[torch.fx.Node, ...]:
+    return tuple(node for node in interval_nodes if any(user not in interval for user in node.users))
+
+
+def _build_region_from_info(info: _GraphInfo, start: int, end: int) -> Region:
+    node_count = len(info.compute_nodes)
+    _validate_interval(start, end, node_count)
+    interval_nodes = info.compute_nodes[start:end]
+    interval = frozenset(interval_nodes)
+    if not interval:
+        raise ValueError(f"region [{start}, {end}) has no compute nodes; empty regions are unsupported")
+
+    external: set[torch.fx.Node] = set()
+
+    def record_dependency(value: torch.fx.Node) -> None:
+        if value not in interval:
+            external.add(value)
+
+    for node in interval_nodes:
+        map_arg(node.args, record_dependency)
+        map_arg(node.kwargs, record_dependency)
+    external_nodes = tuple(sorted(external, key=lambda node: info.node_index[node]))
+
+    graph = torch.fx.Graph()
+    mapping: dict[torch.fx.Node, torch.fx.Node] = {}
+    for dependency in external_nodes:
+        mapping[dependency] = graph.placeholder(dependency.name)
+
+    for original in interval_nodes:
+        args = map_arg(original.args, lambda node: mapping[node])
+        kwargs = map_arg(original.kwargs, lambda node: mapping[node])
+        if original.op == "call_function":
+            copied = graph.call_function(original.target, args=args, kwargs=kwargs)
+        else:
+            copied = graph.call_method(original.target, args=args, kwargs=kwargs)
+        mapping[original] = copied
+
+    boundary = _boundary_outputs(interval_nodes, interval)
+    if not boundary:
+        raise UnsupportedGraph(f"region [{start}, {end}) has no boundary outputs; "
+                               "dead regions are unsupported")
+    graph.output(tuple(mapping[node] for node in boundary))
+    region_gm = torch.fx.GraphModule(torch.nn.Module(), graph)
+    return Region(
+        gm=region_gm,
+        input_names=tuple(node.name for node in external_nodes),
+        output_names=tuple(node.name for node in boundary),
+        start=start,
+        end=end,
+        node_ids=tuple(node.name for node in interval_nodes),
+    )
+
+
+def build_region(gm: torch.fx.GraphModule, start: int, end: int) -> Region:
+    """Build the standalone subgraph for compute-node interval ``[start, end)``."""
+    info = _analyze_graph(gm)
+    return _build_region_from_info(info, start, end)
+
+
+def build_all_regions(gm: torch.fx.GraphModule) -> tuple[Region, ...]:
+    """Enumerate all nonempty contiguous intervals in stable ``(start, end)`` order."""
+    info = _analyze_graph(gm)
+    regions: list[Region] = []
+    for start in range(len(info.compute_nodes)):
+        for end in range(start + 1, len(info.compute_nodes) + 1):
+            regions.append(_build_region_from_info(info, start, end))
+    return tuple(regions)
+
+
+def _fetch_attr(gm: torch.fx.GraphModule, target: str) -> Any:
+    current: Any = gm
+    for atom in target.split("."):
+        try:
+            current = getattr(current, atom)
+        except AttributeError as exc:
+            raise UnsupportedGraph(f"live get_attr target {target!r} is missing") from exc
+    return current
+
+
+def _validate_runtime_value(value: Any, label: str) -> None:
+    if isinstance(value, torch.Tensor):
+        if value.requires_grad:
+            raise UnsupportedGraph(f"{label}: autograd tensors are unsupported; requires_grad=True")
+        return
+    if isinstance(value, Mapping):
+        for index, (key, item) in enumerate(value.items()):
+            _validate_runtime_value(key, f"{label}.key[{index}]")
+            _validate_runtime_value(item, f"{label}.value[{index}]")
+        return
+    if isinstance(value, (tuple, list)):
+        for index, item in enumerate(value):
+            _validate_runtime_value(item, f"{label}[{index}]")
+        return
+    if isinstance(
+            value,
+        (bool, int, float, complex, str, bytes, type(None), slice, torch.dtype, torch.device, torch.layout),
+    ):
+        return
+    memory_format = getattr(torch, "memory_format", None)
+    if memory_format is not None and isinstance(value, memory_format):
+        return
+    raise UnsupportedGraph(f"{label}: unsupported runtime value type {type(value).__name__}")
+
+
+def _normalize_example_inputs(info: _GraphInfo, example_inputs: Sequence[Any]) -> tuple[Any, ...]:
+    if isinstance(example_inputs, (str, bytes, torch.Tensor)) or not isinstance(example_inputs, Sequence):
+        raise TypeError("example_inputs must be an outer sequence of placeholder values")
+    values = tuple(example_inputs)
+    if len(values) != len(info.placeholders):
+        raise ValueError(f"expected {len(info.placeholders)} example inputs, got {len(values)}")
+    for index, value in enumerate(values):
+        _validate_runtime_value(value, f"example_inputs[{index}]")
+    return values
+
+
+def _live_attr_values(info: _GraphInfo) -> dict[torch.fx.Node, Any]:
+    values: dict[torch.fx.Node, Any] = {}
+    for node in info.get_attrs:
+        value = _fetch_attr(info.gm, node.target)
+        _validate_runtime_value(value, f"get_attr[{node.target}]")
+        values[node] = value
+    return values
+
+
+def _validate_graph_tensor_literals(info: _GraphInfo) -> None:
+
+    def scan(value: Any, label: str) -> None:
+        if isinstance(value, torch.fx.Node):
+            return
+        if isinstance(value, torch.Tensor):
+            _validate_runtime_value(value, label)
+            return
+        if isinstance(value, Mapping):
+            for index, (key, item) in enumerate(value.items()):
+                scan(key, f"{label}.key[{index}]")
+                scan(item, f"{label}.value[{index}]")
+            return
+        if isinstance(value, (tuple, list)):
+            for index, item in enumerate(value):
+                scan(item, f"{label}[{index}]")
+        # Non-tensor literals are target arguments, not executable graph data
+        # sources; they are handled by target/argument preservation.
+
+    for node in info.nodes:
+        if node.op in ("call_function", "call_method"):
+            scan(node.args, f"{node.name}.args")
+            scan(node.kwargs, f"{node.name}.kwargs")
+    scan(info.output_structure, "output")
+
+
+def _external_value_map(info: _GraphInfo, external_values: Mapping[str, Any]) -> dict[str, Any]:
+    if not isinstance(external_values, Mapping):
+        raise TypeError("external_values must be a mapping of node name to value")
+    known_names = {node.name for node in info.nodes}
+    for name in external_values:
+        if not isinstance(name, str):
+            raise ValueError("external_values keys must be string node names")
+        if name not in known_names:
+            raise ValueError(f"external_values contains unknown node name {name!r}")
+    return {node.name: external_values[node.name] for node in info.nodes if node.name in external_values}
+
+
+def _capture_active(values):
+    from torch.utils._pytree import tree_leaves
+    real_gpu = any(
+        isinstance(v, torch.Tensor) and v.device.type == "cuda" and getattr(v, "fake_mode", None) is None
+        for v in tree_leaves(values))
+    return real_gpu and torch.cuda.is_current_stream_capturing()
+
+
+def collect_example_values(
+    gm: torch.fx.GraphModule,
+    example_inputs: Sequence[Any] | None = None,
+    *,
+    external_values: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Record original FX node values offline, or accept an external metadata map.
+
+    Offline execution validates the graph, all example values, and every live
+    get_attr before invoking ``torch.fx.Interpreter`` on the original targets.
+    If ``external_values`` is supplied, it takes precedence and no PyTorch or
+    generated code is executed; ``example_inputs`` is then ignored.
+    """
+    info = _analyze_graph(gm)
+    if external_values is not None:
+        return _external_value_map(info, external_values)
+    if example_inputs is None:
+        raise ValueError("example_inputs are required when external_values is omitted")
+
+    inputs = _normalize_example_inputs(info, example_inputs)
+    attrs = _live_attr_values(info)
+    _validate_graph_tensor_literals(info)
+    if _capture_active((inputs, tuple(attrs.values()))):
+        raise UnsupportedGraph("offline example collection is forbidden during graph capture")
+    interpreter = _RecordingInterpreter(gm)
+    with torch.no_grad():
+        interpreter.run(*inputs)
+    return dict(interpreter.values)
+
+
+def _validate_plan(plan: Any, info: _GraphInfo) -> tuple[Any, ...]:
+    if not isinstance(plan, PartitionPlan):
+        raise PartitionExecutionError("plan must be an accepted resource_planner.PartitionPlan")
+    context_key = plan.context_key
+    if not isinstance(context_key, str) or not context_key.strip():
+        raise PartitionExecutionError("plan context_key must be nonempty")
+    scope = plan.validated_scope
+    if scope.context_key != context_key:
+        raise PartitionExecutionError("plan validated_scope context does not match plan context")
+    if scope.start != 0 or scope.end != len(info.compute_nodes):
+        raise PartitionExecutionError("plan validated_scope does not span the graph's compute nodes")
+    if tuple(scope.node_ids) != info.compute_ids:
+        raise PartitionExecutionError("plan node IDs do not match the graph compute-node order")
+
+    regions = tuple(sorted(plan.regions, key=lambda region: (region.start, region.end)))
+    if not regions:
+        raise PartitionExecutionError("plan contains no regions")
+    next_start = 0
+    for region in regions:
+        if region.context_key != context_key:
+            raise PartitionExecutionError("every plan region context must match the plan context")
+        if region.start != next_start or region.end <= region.start:
+            raise PartitionExecutionError("plan regions must be nonempty, ordered, and contiguous")
+        if region.end > len(info.compute_nodes):
+            raise PartitionExecutionError("plan region extends beyond the graph's compute nodes")
+        expected_ids = info.compute_ids[region.start:region.end]
+        if tuple(region.node_ids) != expected_ids:
+            raise PartitionExecutionError(f"plan region [{region.start}, {region.end}) node IDs do not "
+                                          "match the graph")
+        next_start = region.end
+    if next_start != len(info.compute_nodes):
+        raise PartitionExecutionError("plan does not fully cover the graph's compute nodes")
+    return regions
+
+
+def _thaw_fx_output_structure(value: Any) -> Any:
+    """Use runtime-style list/dict literals instead of FX's immutable wrappers."""
+    if isinstance(value, _FxImmutableDict):
+        return {key: _thaw_fx_output_structure(item) for key, item in value.items()}
+    if isinstance(value, _FxImmutableList):
+        return [_thaw_fx_output_structure(item) for item in value]
+    if type(value) is tuple:
+        return tuple(_thaw_fx_output_structure(item) for item in value)
+    return value
+
+
+def execute_partition(
+    gm: torch.fx.GraphModule,
+    plan: PartitionPlan,
+    compiled_regions: Mapping[tuple[int, int, str], Any],
+    *inputs: Any,
+) -> Any:
+    """Execute a fully compiled contiguous partition using explicit region cuts.
+
+    ``compiled_regions`` must contain one callable per plan region keyed by
+    ``(start, end, resource)``.  Every callable is preflighted before execution;
+    there is no original-target fallback.  The helper rechecks graph/plan node
+    identity, coverage, and plan-internal context alignment, but it cannot
+    recompute environment guards or provide runtime numerical validation.
+    """
+    info = _analyze_graph(gm)
+    regions = _validate_plan(plan, info)
+    if not isinstance(compiled_regions, Mapping):
+        raise TypeError("compiled_regions must be a mapping")
+
+    build_cache: dict[tuple[int, int], Region] = {}
+    call_specs: list[tuple[Any, tuple[str, ...], tuple[str, ...], tuple[int, int, str]]] = []
+    for plan_region in regions:
+        region_key = (plan_region.start, plan_region.end)
+        region = build_cache.get(region_key)
+        if region is None:
+            region = _build_region_from_info(info, plan_region.start, plan_region.end)
+            build_cache[region_key] = region
+        compiled_key = (
+            plan_region.start,
+            plan_region.end,
+            plan_region.resource,
+        )
+        if compiled_key not in compiled_regions:
+            raise PartitionExecutionError(f"missing compiled region for key {compiled_key!r}")
+        compiled = compiled_regions[compiled_key]
+        if not callable(compiled):
+            raise PartitionExecutionError(f"compiled region for key {compiled_key!r} is not callable")
+        call_specs.append((
+            compiled,
+            tuple(region.input_names),
+            tuple(region.output_names),
+            compiled_key,
+        ))
+
+    if len(inputs) != len(info.placeholders):
+        raise PartitionExecutionError(f"expected {len(info.placeholders)} runtime inputs, got {len(inputs)}")
+    for index, value in enumerate(inputs):
+        _validate_runtime_value(value, f"inputs[{index}]")
+    attr_values = _live_attr_values(info)
+    _validate_graph_tensor_literals(info)
+
+    node_by_name = {node.name: node for node in info.nodes}
+    values: dict[torch.fx.Node, Any] = {}
+    for placeholder, value in zip(info.placeholders, inputs):
+        values[placeholder] = value
+    values.update(attr_values)
+
+    for compiled, input_names, output_names, compiled_key in call_specs:
+        region_inputs = tuple(values[node_by_name[name]] for name in input_names)
+        outputs = compiled(*region_inputs)
+        if not isinstance(outputs, tuple):
+            raise PartitionExecutionError(f"compiled region {compiled_key!r} must return a tuple")
+        if len(outputs) != len(output_names):
+            raise PartitionExecutionError(f"compiled region {compiled_key!r} returned {len(outputs)} outputs; "
+                                          f"expected {len(output_names)}")
+        for name, value in zip(output_names, outputs):
+            values[node_by_name[name]] = value
+
+    try:
+        mapped_output = map_arg(info.output_structure, lambda node: values[node])
+        return _thaw_fx_output_structure(mapped_output)
+    except KeyError as exc:
+        raise PartitionExecutionError("execution did not produce a value required by the final output") from exc
+
+
+def _encode_tensor_metadata(value: torch.Tensor, path: str) -> dict[str, Any]:
+    if value.requires_grad:
+        raise UnsupportedGraph(f"{path}: autograd tensor metadata is unsupported")
+    try:
+        shape = [int(item) for item in value.shape]
+        stride = [int(item) for item in value.stride()]
+        storage_offset = int(value.storage_offset())
+    except (RuntimeError, TypeError, ValueError) as exc:
+        raise UnsupportedGraph(f"{path}: tensor layout metadata is unsupported") from exc
+    return {
+        "kind": "tensor",
+        "shape": shape,
+        "stride": stride,
+        "dtype": str(value.dtype),
+        "device": str(value.device),
+        "requires_grad": bool(value.requires_grad),
+        "storage_offset": storage_offset,
+    }
+
+
+def _encode_value(
+    value: Any,
+    node_index: Mapping[torch.fx.Node, int] | None = None,
+    path: str = "value",
+) -> Any:
+    if isinstance(value, torch.fx.Node):
+        if node_index is None or value not in node_index:
+            raise UnsupportedGraph(f"{path}: FX node reference outside graph")
+        return {"kind": "node_ref", "index": node_index[value]}
+    if isinstance(value, torch.Tensor):
+        return _encode_tensor_metadata(value, path)
+    if value is None:
+        return {"kind": "none"}
+    if isinstance(value, bool):
+        return {"kind": "bool", "value": value}
+    if isinstance(value, int):
+        return {"kind": "int", "value": value}
+    if isinstance(value, float):
+        if math.isnan(value):
+            text = "nan"
+        elif math.isinf(value):
+            text = "inf" if value > 0 else "-inf"
+        else:
+            return {"kind": "float", "value": value}
+        return {"kind": "float", "value": text}
+    if isinstance(value, complex):
+        return {
+            "kind": "complex",
+            "real": _encode_value(value.real, node_index, path + ".real"),
+            "imag": _encode_value(value.imag, node_index, path + ".imag"),
+        }
+    if isinstance(value, str):
+        return {"kind": "str", "value": value}
+    if isinstance(value, bytes):
+        return {"kind": "bytes", "value": value.hex()}
+    if value is Ellipsis:
+        return {"kind": "ellipsis"}
+    if isinstance(value, torch.Size):
+        return {
+            "kind": "size",
+            "items": [_encode_value(item, node_index, path + f"[{i}]") for i, item in enumerate(value)],
+        }
+    if isinstance(value, torch.dtype):
+        return {"kind": "dtype", "value": str(value)}
+    if isinstance(value, torch.device):
+        return {"kind": "device", "value": str(value)}
+    if isinstance(value, torch.layout):
+        return {"kind": "layout", "value": str(value)}
+    memory_format = getattr(torch, "memory_format", None)
+    if memory_format is not None and isinstance(value, memory_format):
+        return {"kind": "memory_format", "value": str(value)}
+    if isinstance(value, slice):
+        return {
+            "kind": "slice",
+            "start": _encode_value(value.start, node_index, path + ".start"),
+            "stop": _encode_value(value.stop, node_index, path + ".stop"),
+            "step": _encode_value(value.step, node_index, path + ".step"),
+        }
+    if isinstance(value, tuple):
+        return {
+            "kind": "tuple",
+            "items": [_encode_value(item, node_index, path + f"[{i}]") for i, item in enumerate(value)],
+        }
+    if isinstance(value, list):
+        return {
+            "kind": "list",
+            "items": [_encode_value(item, node_index, path + f"[{i}]") for i, item in enumerate(value)],
+        }
+    if isinstance(value, Mapping):
+        encoded_items = []
+        for index, (key, item) in enumerate(value.items()):
+            encoded_key = _encode_value(key, node_index, path + f".key[{index}]")
+            encoded_value = _encode_value(item, node_index, path + f".value[{index}]")
+            encoded_items.append((encoded_key, encoded_value))
+        encoded_items.sort(key=lambda pair: json.dumps(
+            pair[0],
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        ))
+        return {
+            "kind": "mapping",
+            "items": [{"key": key, "value": item} for key, item in encoded_items],
+        }
+    raise UnsupportedGraph(f"{path}: unsupported value type {type(value).__name__}")
+
+
+def _encode_node(info: _GraphInfo, node: torch.fx.Node) -> dict[str, Any]:
+    data: dict[str, Any] = {
+        "op": node.op,
+        "args": _encode_value(node.args, info.node_index, f"{node.name}.args"),
+        "kwargs": _encode_value(node.kwargs, info.node_index, f"{node.name}.kwargs"),
+    }
+    if node.op == "call_function":
+        data["target_kind"] = "function"
+        data["target"] = _target_identity(node.target)
+    elif node.op == "call_method":
+        data["target_kind"] = "method"
+        data["target"] = node.target
+    elif node.op in ("placeholder", "get_attr"):
+        data["target_kind"] = "data"
+        data["target"] = node.target
+    elif node.op == "output":
+        data["target_kind"] = "output"
+        data["target"] = "output"
+    else:
+        raise UnsupportedGraph(f"{node.name!r}: unsupported FX node kind")
+    return data
+
+
+def context_fingerprint(
+    gm: torch.fx.GraphModule,
+    example_inputs: Sequence[Any],
+    environment_key: str,
+) -> str:
+    """Hash canonical graph/input/live-attr metadata and an environment key.
+
+    Tensor contents, data pointers, and storage contents are never read.  The
+    parent supplies ``environment_key`` (hardware/compiler/precision); this
+    function does not execute or validate the full partition numerically.
+    """
+    if not isinstance(environment_key, str) or not environment_key.strip():
+        raise ValueError("environment_key must be a nonempty string")
+    info = _analyze_graph(gm)
+    inputs = _normalize_example_inputs(info, example_inputs)
+    attr_values = _live_attr_values(info)
+
+    input_payload = [{
+        "placeholder": placeholder.name,
+        "value": _encode_value(value, None, f"example_inputs[{index}]"),
+    } for index, (placeholder, value) in enumerate(zip(info.placeholders, inputs))]
+    attr_payload = [{
+        "target": node.target,
+        "value": _encode_value(attr_values[node], None, f"get_attr[{node.target}]"),
+    } for node in info.get_attrs]
+    payload = {
+        "schema": "resource_fx_fingerprint_v1",
+        "environment_key": environment_key,
+        "nodes": [_encode_node(info, node) for node in info.nodes],
+        "compute_node_indices": [info.node_index[node] for node in info.compute_nodes],
+        "output_structure": _encode_value(info.output_structure, info.node_index, "output"),
+        "inputs": input_payload,
+        "get_attrs": attr_payload,
+    }
+    canonical = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
diff --git a/python/triton/experimental/graph_fusion/_resource_planner.py b/python/triton/experimental/graph_fusion/_resource_planner.py
new file mode 100644
index 000000000..fe297857e
--- /dev/null
+++ b/python/triton/experimental/graph_fusion/_resource_planner.py
@@ -0,0 +1,568 @@
+"""Deterministic, resource-aware contiguous graph partition planning.
+
+This module is pure scheduling metadata.  It does not generate code, invoke
+kernels, capture timings, autotune, or certify a deployed plan.
+
+The parent supplies an ordered sequence of compute-node IDs and profiled
+observations for positional half-open intervals ``[start, end)``.  Observations
+are usable only when they match the caller's exact context fingerprint and pass
+all validation gates.  Planning is an exact dynamic program over contiguous
+intervals; no unmeasured interval costs are inferred.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+from collections.abc import Iterable, Mapping, Sequence
+from dataclasses import dataclass
+from numbers import Real
+from typing import Any, TypeAlias
+
+__all__ = [
+    "DEPLOYMENT_ADVISORY",
+    "NoPlan",
+    "PartitionDecision",
+    "PartitionPlan",
+    "PlannedRegion",
+    "ProfileObservation",
+    "REQUIRED_CHECKS",
+    "RESOURCES",
+    "Rejection",
+    "ValidatedScope",
+    "audit_json",
+    "choose_partition",
+]
+
+RESOURCES: tuple[str, ...] = ("sdnn", "cluster")
+
+# Alphabetical order makes exact-cost ties independent of any speed assumption.
+_RESOURCE_ORDER: dict[str, int] = {"cluster": 0, "sdnn": 1}
+
+REQUIRED_CHECKS: tuple[str, ...] = (
+    "compile_ok",
+    "ordinary_ok",
+    "repeat_ok",
+    "special_ok",
+    "immutable_ok",
+)
+
+DEPLOYMENT_ADVISORY: str = ("Scheduling metadata only. Before deployment, the full partition plan "
+                            "requires end-to-end numerical validation and performance validation on the "
+                            "target backend/context. No runtime autotune or capture occurred, and this "
+                            "result is not a production certification.")
+
+
+@dataclass(frozen=True)
+class ProfileObservation:
+    """One measured contiguous interval for one resource.
+
+    ``start`` and ``end`` are positional indices into the planner's ordered
+    ``node_ids`` sequence.  ``median_us`` must cover this whole interval,
+    including output materialization.  ``verified_resources`` is the parent's
+    immutable evidence tuple for every generated kernel in the interval; it
+    must be nonempty and contain only ``resource``.  External calls and native
+    mm nodes without verified evidence must not be represented as SDNN.
+    """
+
+    resource: str
+    context_key: str
+    start: int
+    end: int
+    median_us: float
+    evidence_id: str
+    verified_resources: tuple[str, ...]
+    compile_ok: bool = False
+    ordinary_ok: bool = False
+    repeat_ok: bool = False
+    special_ok: bool = False
+    immutable_ok: bool = False
+    external_calls: int = 0
+    invalid_reason: str | None = None
+
+
+@dataclass(frozen=True)
+class Rejection:
+    """A retained reason for excluding an observation or declining a plan."""
+
+    reason: str
+    observation_index: int | None = None
+    evidence_id: str | None = None
+
+    def to_audit_dict(self) -> dict[str, Any]:
+        return {
+            "reason": self.reason,
+            "observation_index": self.observation_index,
+            "evidence_id": self.evidence_id,
+        }
+
+
+@dataclass(frozen=True)
+class PlannedRegion:
+    """One selected contiguous interval and its source measurement."""
+
+    start: int
+    end: int
+    node_ids: tuple[str, ...]
+    resource: str
+    median_us: float
+    evidence_id: str
+    context_key: str
+    verified_resources: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class ValidatedScope:
+    """Scope over which a plan's observations were validated."""
+
+    context_key: str
+    start: int
+    end: int
+    node_ids: tuple[str, ...]
+    checks_passed: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class PartitionPlan:
+    """A complete, contiguous scheduling-only partition recommendation."""
+
+    context_key: str
+    regions: tuple[PlannedRegion, ...]
+    total_estimated_us: float
+    cut_cost_us: float
+    validated_scope: ValidatedScope
+    rejections: tuple[Rejection, ...]
+    advisory: str = DEPLOYMENT_ADVISORY
+
+    @property
+    def status(self) -> str:
+        return "plan"
+
+    @property
+    def total_regions(self) -> int:
+        return len(self.regions)
+
+    def to_audit_dict(self) -> dict[str, Any]:
+        return {
+            "status":
+            self.status,
+            "context_key":
+            self.context_key,
+            "total_estimated_us":
+            self.total_estimated_us,
+            "cut_cost_us":
+            self.cut_cost_us,
+            "validated_scope": {
+                "context_key": self.validated_scope.context_key,
+                "start": self.validated_scope.start,
+                "end": self.validated_scope.end,
+                "node_ids": list(self.validated_scope.node_ids),
+                "checks_passed": list(self.validated_scope.checks_passed),
+            },
+            "regions": [{
+                "start": region.start,
+                "end": region.end,
+                "node_ids": list(region.node_ids),
+                "resource": region.resource,
+                "median_us": region.median_us,
+                "evidence_id": region.evidence_id,
+                "context_key": region.context_key,
+                "verified_resources": list(region.verified_resources),
+            } for region in self.regions],
+            "rejections": [rejection.to_audit_dict() for rejection in self.rejections],
+            "advisory":
+            self.advisory,
+        }
+
+
+@dataclass(frozen=True)
+class NoPlan:
+    """Explicit no-plan result; the parent may keep its native Inductor path."""
+
+    context_key: str
+    node_count: int
+    rejections: tuple[Rejection, ...]
+    advisory: str = DEPLOYMENT_ADVISORY
+
+    @property
+    def status(self) -> str:
+        return "no_plan"
+
+    def to_audit_dict(self) -> dict[str, Any]:
+        return {
+            "status": self.status,
+            "context_key": self.context_key,
+            "node_count": self.node_count,
+            "rejections": [rejection.to_audit_dict() for rejection in self.rejections],
+            "advisory": self.advisory,
+        }
+
+
+PartitionDecision: TypeAlias = PartitionPlan | NoPlan
+
+
+@dataclass(frozen=True)
+class _Candidate:
+    start: int
+    end: int
+    resource: str
+    median_us: float
+    evidence_id: str
+    context_key: str
+    verified_resources: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class _Partial:
+    regions: tuple[_Candidate, ...]
+    total_us: float
+    cut_us: float
+
+
+def _validate_node_ids(node_ids: Sequence[str]) -> tuple[str, ...]:
+    if isinstance(node_ids, (str, bytes)) or not isinstance(node_ids, Sequence):
+        raise TypeError("node_ids must be an ordered sequence of unique node ID strings")
+    ordered = tuple(node_ids)
+    if not ordered:
+        raise ValueError("node_ids must not be empty")
+    seen: set[str] = set()
+    for index, node_id in enumerate(ordered):
+        if not isinstance(node_id, str):
+            raise TypeError(f"node_ids[{index}] must be a string")
+        if not node_id.strip():
+            raise ValueError(f"node_ids[{index}] must be nonempty")
+        if node_id in seen:
+            raise ValueError(f"duplicate node ID at index {index}: {node_id!r}")
+        seen.add(node_id)
+    return ordered
+
+
+def _validate_context_key(context_key: str) -> str:
+    if not isinstance(context_key, str):
+        raise TypeError("context_key must be a string")
+    if not context_key.strip():
+        raise ValueError("context_key must be nonempty")
+    return context_key
+
+
+def _validate_max_regions(max_regions: int | None) -> None:
+    if max_regions is None:
+        return
+    if isinstance(max_regions, bool) or not isinstance(max_regions, int):
+        raise TypeError("max_regions must be a positive integer when provided")
+    if max_regions <= 0:
+        raise ValueError("max_regions must be positive")
+
+
+def _coerce_boundary_cost(value: object, label: str) -> float:
+    if isinstance(value, bool) or not isinstance(value, Real):
+        raise TypeError(f"{label} must be a finite non-negative number")
+    try:
+        cost = float(value)
+    except (OverflowError, ValueError) as exc:
+        raise ValueError(f"{label} must be a finite non-negative number") from exc
+    if not math.isfinite(cost) or cost < 0.0:
+        raise ValueError(f"{label} must be a finite non-negative number")
+    return cost
+
+
+def _normalize_boundary_costs(
+    node_count: int,
+    boundary_costs: Sequence[float] | Mapping[int, float] | None,
+) -> tuple[float, ...]:
+    """Return cuts indexed by the node index immediately before the cut."""
+    cut_count = max(node_count - 1, 0)
+    costs = [0.0] * cut_count
+    if boundary_costs is None:
+        return tuple(costs)
+
+    if isinstance(boundary_costs, Mapping):
+        for cut_index, value in boundary_costs.items():
+            if isinstance(cut_index, bool) or not isinstance(cut_index, int):
+                raise TypeError("boundary cost mapping keys must be integer cut indices")
+            if cut_index < 0 or cut_index >= cut_count:
+                raise ValueError(f"boundary cut index {cut_index} is outside [0, {cut_count - 1}]")
+            costs[cut_index] = _coerce_boundary_cost(value, f"boundary_costs[{cut_index}]")
+        return tuple(costs)
+
+    if isinstance(boundary_costs, (str, bytes)) or not isinstance(boundary_costs, Sequence):
+        raise TypeError("boundary_costs must be a sequence of length node_count - 1, "
+                        "a cut-index mapping, or None")
+    if len(boundary_costs) != cut_count:
+        raise ValueError(f"boundary_costs must have exactly {cut_count} entries, "
+                         f"got {len(boundary_costs)}")
+    for cut_index, value in enumerate(boundary_costs):
+        costs[cut_index] = _coerce_boundary_cost(value, f"boundary_costs[{cut_index}]")
+    return tuple(costs)
+
+
+def _safe_evidence_id(observation: ProfileObservation) -> str | None:
+    evidence_id = observation.evidence_id
+    if isinstance(evidence_id, str) and evidence_id.strip():
+        return evidence_id
+    return None
+
+
+def _observation_rejection_reasons(
+    observation: ProfileObservation,
+    node_count: int,
+    context_key: str,
+) -> tuple[str, ...]:
+    reasons: list[str] = []
+
+    if observation.invalid_reason is not None:
+        if isinstance(observation.invalid_reason, str):
+            detail = observation.invalid_reason.strip()
+            reasons.append(f"invalid observation: {detail or 'invalid_reason was provided'}")
+        else:
+            reasons.append("invalid observation: invalid_reason is not a string")
+
+    if not isinstance(observation.context_key, str) or not observation.context_key.strip():
+        reasons.append("context_key must be a nonempty string")
+    elif observation.context_key != context_key:
+        reasons.append("context mismatch: observations are exact and are not extrapolated")
+
+    if not isinstance(observation.resource, str) or observation.resource not in RESOURCES:
+        reasons.append(f"resource must be one of {RESOURCES!r}")
+
+    range_is_well_typed = (isinstance(observation.start, int) and not isinstance(observation.start, bool)
+                           and isinstance(observation.end, int) and not isinstance(observation.end, bool))
+    if not range_is_well_typed:
+        reasons.append("range start/end must be integer positional indices")
+    elif not (0 <= observation.start < observation.end <= node_count):
+        reasons.append(f"range [{observation.start}, {observation.end}) is not a nonempty "
+                       f"subrange of [0, {node_count})")
+
+    cost_is_valid = False
+    if isinstance(observation.median_us, Real) and not isinstance(observation.median_us, bool):
+        try:
+            cost = float(observation.median_us)
+        except (OverflowError, ValueError):
+            cost = math.nan
+        cost_is_valid = math.isfinite(cost) and cost > 0.0
+    if not cost_is_valid:
+        reasons.append("median_us must be a finite positive number")
+
+    if (not isinstance(observation.evidence_id, str) or not observation.evidence_id.strip()):
+        reasons.append("evidence_id must be a nonempty string")
+
+    evidence = observation.verified_resources
+    if not isinstance(evidence, tuple):
+        reasons.append("resource evidence must be a nonempty tuple")
+    elif not evidence:
+        reasons.append("resource evidence is missing; no verified kernels")
+    elif any(not isinstance(item, str) or item != observation.resource for item in evidence):
+        reasons.append("resource evidence must contain only the requested resource; "
+                       "mixed or unverified evidence is not usable")
+
+    for check_name in REQUIRED_CHECKS:
+        if getattr(observation, check_name, None) is not True:
+            reasons.append(f"required check {check_name} did not pass")
+
+    if (isinstance(observation.external_calls, bool) or not isinstance(observation.external_calls, int)
+            or observation.external_calls != 0):
+        reasons.append("external_calls must be the integer 0; external kernels are unverified")
+
+    return tuple(reasons)
+
+
+def _candidate_sort_key(candidate: _Candidate) -> tuple[Any, ...]:
+    return (
+        _RESOURCE_ORDER[candidate.resource],
+        candidate.end,
+        candidate.evidence_id,
+        candidate.median_us,
+        candidate.context_key,
+        candidate.verified_resources,
+    )
+
+
+def _path_sort_key(partial: _Partial) -> tuple[Any, ...]:
+    return (
+        partial.total_us,
+        len(partial.regions),
+        tuple(_RESOURCE_ORDER[region.resource] for region in partial.regions),
+        tuple((region.start, region.end) for region in partial.regions),
+        tuple(region.evidence_id for region in partial.regions),
+    )
+
+
+def _assert_full_coverage(regions: tuple[_Candidate, ...], node_count: int) -> None:
+    if not regions or regions[0].start != 0 or regions[-1].end != node_count:
+        raise RuntimeError("internal error: plan does not cover the full node range")
+    for previous, current in zip(regions, regions[1:]):
+        if previous.end != current.start:
+            raise RuntimeError("internal error: plan has a gap or overlap")
+
+
+def choose_partition(
+    node_ids: Sequence[str],
+    context_key: str,
+    observations: Iterable[ProfileObservation],
+    boundary_costs: Sequence[float] | Mapping[int, float] | None = None,
+    *,
+    is_baidu_backend: bool,
+    max_regions: int | None = None,
+) -> PartitionDecision:
+    """Choose an exact minimum-cost contiguous partition, or explicit no-plan.
+
+    ``boundary_costs[i]`` (sequence position or mapping key ``i``) is the
+    caller-supplied cost of cutting after node index ``i``.  A missing mapping
+    entry defaults to zero and ``None`` means all cuts are zero.  Supplied costs
+    already include region materialization; this planner adds no other overhead.
+
+    Validation failures for malformed planning arguments raise ``TypeError`` or
+    ``ValueError``.  Bad observations are excluded and their reasons are kept
+    in the result's ``rejections`` tuple.  A false Baidu flag yields ``NoPlan``;
+    a non-boolean flag raises ``TypeError``.
+    """
+    ordered_nodes = _validate_node_ids(node_ids)
+    context_key = _validate_context_key(context_key)
+    if not isinstance(is_baidu_backend, bool):
+        raise TypeError("is_baidu_backend must be a bool")
+    _validate_max_regions(max_regions)
+    cuts = _normalize_boundary_costs(len(ordered_nodes), boundary_costs)
+
+    if isinstance(observations, (str, bytes, ProfileObservation)) or not isinstance(observations, Iterable):
+        raise TypeError("observations must be an iterable of ProfileObservation")
+    observations_tuple = tuple(observations)
+
+    node_count = len(ordered_nodes)
+    rejections: list[Rejection] = []
+    candidates: list[_Candidate] = []
+
+    for index, observation in enumerate(observations_tuple):
+        if not isinstance(observation, ProfileObservation):
+            rejections.append(
+                Rejection(
+                    reason="observation must be a ProfileObservation instance",
+                    observation_index=index,
+                ))
+            continue
+        reasons = _observation_rejection_reasons(observation, node_count, context_key)
+        safe_evidence_id = _safe_evidence_id(observation)
+        for reason in reasons:
+            rejections.append(Rejection(
+                reason=reason,
+                observation_index=index,
+                evidence_id=safe_evidence_id,
+            ))
+        if reasons:
+            continue
+        candidates.append(
+            _Candidate(
+                start=observation.start,
+                end=observation.end,
+                resource=observation.resource,
+                median_us=float(observation.median_us),
+                evidence_id=observation.evidence_id,
+                context_key=observation.context_key,
+                verified_resources=observation.verified_resources,
+            ))
+
+    if not is_baidu_backend:
+        rejections.append(
+            Rejection(reason=("backend: planner is enabled only for a positively identified "
+                              "Baidu backend")))
+        return NoPlan(
+            context_key=context_key,
+            node_count=node_count,
+            rejections=tuple(rejections),
+        )
+
+    if not candidates:
+        rejections.append(Rejection(reason="plan: no eligible profile observations after validation"))
+        return NoPlan(
+            context_key=context_key,
+            node_count=node_count,
+            rejections=tuple(rejections),
+        )
+
+    by_start: list[list[_Candidate]] = [[] for _ in range(node_count)]
+    for candidate in candidates:
+        by_start[candidate.start].append(candidate)
+    for start in range(node_count):
+        by_start[start].sort(key=_candidate_sort_key)
+
+    region_limit = node_count if max_regions is None else min(max_regions, node_count)
+    # states[end][region_count] -> best partial plan for [0, end).
+    states: list[dict[int, _Partial]] = [dict() for _ in range(node_count + 1)]
+    states[0][0] = _Partial(regions=(), total_us=0.0, cut_us=0.0)
+
+    for end in range(node_count):
+        if not states[end]:
+            continue
+        starting_here = by_start[end]
+        if not starting_here:
+            continue
+        for region_count, partial in tuple(states[end].items()):
+            next_count = region_count + 1
+            if next_count > region_limit:
+                continue
+            cut_cost = 0.0 if end == 0 else cuts[end - 1]
+            for candidate in starting_here:
+                new_total = partial.total_us + candidate.median_us + cut_cost
+                if not math.isfinite(new_total):
+                    continue
+                new_partial = _Partial(
+                    regions=partial.regions + (candidate, ),
+                    total_us=new_total,
+                    cut_us=partial.cut_us + cut_cost,
+                )
+                previous = states[candidate.end].get(next_count)
+                if previous is None or _path_sort_key(new_partial) < _path_sort_key(previous):
