-    if not bool(torch.isfinite(lo).all() and torch.isfinite(hi).all()):
-        raise AssertionError('non-finite BF16 interval endpoint')
-    if not bool((lo <= hi).all()):
-        raise AssertionError('invalid BF16 accumulation interval')
-    return lo, hi, gamma
