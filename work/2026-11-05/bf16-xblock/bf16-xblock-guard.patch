+# P800 bf16 pointwise codegen under-writes when a config's XBLOCK exceeds the
+# heuristic base tile: the candidate fails to compile (OutOfResources: uni_sram),
+# the launcher silently falls back to the base tile while the grid still uses the
+# requested XBLOCK, so only 1024/XBLOCK of the output is written and the rest
+# keeps uninitialized memory (bf16 often reads back as 0x7F80 = +inf).
+# f32/f16 compile the same tiles and are unaffected.
+# Plain module global: the tuner runs on a compile worker thread, where a
+# ContextVar set by the caller is not visible.
+_MAX_XBLOCK = None
 
 
