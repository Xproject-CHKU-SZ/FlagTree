+// reduce_mt distributes 2 KiB partials across the cores in column-block
+// order. Its compensation survives when a core advances to a different row.
+template<class T> static __device__ inline void shard_sum(const _global_ptr_ T *a,
+        const _global_ptr_ T *bias, _global_ptr_ T *out, int first, int rows, int n) {
+#pragma clang fp contract(off)
+    __shared__ __simd__ T b[2048], output[64];
+    __shared__ __simd__ float partials[4][64];
+    __simd__ T tile[512];
+    const int cid = core_id(), parts = (n + 511) / 512;
+    if (cid == 0) {
+        GM2SM_ASYNC(bias, b, n * sizeof(T));
+        mfence_sm_gm();
+        for (int i = n; i < ((n + 31) & ~31); ++i) b[i] = 0;
+    }
+    mfence();
+    sync_cluster();
+    float carry = 0.f;
+    for (int task = cid; task < parts * rows; task += core_num()) {
+        int part = task / rows, row = task % rows;
+        int off = part * 512, count = n - off < 512 ? n - off : 512;
+        int padded = (count + 31) & ~31;
+        GM2LM(a + (first + row) * n + off, tile, count * sizeof(T));
+        for (int i = count; i < padded; ++i) tile[i] = 0;
+        mfence_lm();
+        float value = serial_fold(fp32_chunk(tile, b + off, padded)) - carry;
+        partials[part][row] = value;
+        carry = value - value;
+    }
+    mfence();
+    sync_cluster();
+    if (cid < rows) {
+        float sum = partials[0][cid];
+        for (int part = 1; part < parts; ++part) sum += partials[part][cid];
+        store_final_sum(output + cid, sum);
+    }
+    mfence();
+    sync_cluster();
+    if (cid == 0 && rows) SM2GM(output, out + first, rows * sizeof(T));
+}
+#define SHARD_SUM(name, T) \
+extern "C" __device__ void name(const _global_ptr_ T *a, const _global_ptr_ T *b, _global_ptr_ T *o, \
+                                int first, int rows, int n) { shard_sum(a,b,o,first,rows,n); }
+SHARD_SUM(kl3_shard_sum_float, float)
+SHARD_SUM(kl3_shard_sum_bf, int16_t)
+SHARD_SUM(kl3_shard_sum_half, uint16_t)
+
+// Odd row strides change the bias phase on each flat tile. Stage valid bytes
+// of one row and share one bias per cluster instead of computing a remainder
+// for every output element.
+extern "C" __device__ void kl3_bf_activation_rows(const _global_ptr_ int16_t *a,
+        const _global_ptr_ int16_t *bias, _global_ptr_ int16_t *out,
+        int first, int rows, int n, int mode) {
+    __shared__ __simd__ int16_t b[1024];
+    __simd__ int16_t tile[1024];
+    const int padded = (n + 31) & ~31;
+    if (core_id() == 0) {
+        GM2SM_ASYNC(bias, b, n * sizeof(int16_t));
+        mfence_sm_gm();
+        for (int i = n; i < padded; ++i) b[i] = 0;
+    }
+    mfence();
+    sync_cluster();
+    for (int row = core_id(); row < rows; row += core_num()) {
+        int offset = (first + row) * n;
+        GM2LM(a + offset, tile, n * sizeof(int16_t));
+        for (int i = n; i < padded; ++i) tile[i] = 0;
+        mfence_lm();
+        for (int i = 0; i < padded; i += 32) {
+            Pair x = point_read(tile + i), y = point_shared(b + i);
+            save_final(tile + i, {activation(x.x + y.x, mode), activation(x.y + y.y, mode)});
+        }
+        mfence_lm();
+        LM2GM(tile, out + offset, n * sizeof(int16_t));
+    }
+}
