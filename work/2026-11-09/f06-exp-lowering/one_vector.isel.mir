--- |
  ; ModuleID = 'work/2026-11-09/f06-exp-lowering/one_vector.ll'
  source_filename = "work/2026-11-09/f06-exp-lowering/one_vector.ll"
  target datalayout = "e-m:e-p:32:32-p1:64:64-p2:32:32-p4:32:32-p135:64:64-p134:64:64-p133:32:32-p131:64:64-i1:8:32-i8:8:32-i16:16:32-i64:64:64-f64:64:64-v512:512-a:0:32-n32-S32"
  target triple = "xpu3-baidu-none-gnu"
  
  define void @one_vector(ptr %out, ptr %in) #0 {
  entry:
    %x = load <16 x float>, ptr %in, align 64
    %y = call <16 x float> @llvm.exp2.v16f32(<16 x float> %x)
    store <16 x float> %y, ptr %out, align 64
    ret void
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
  declare <16 x float> @llvm.exp2.v16f32(<16 x float>) #1
  
  ; Function Attrs: nounwind memory(write)
  declare void @_exit() #2
  
  attributes #0 = { "target-cpu"="xpu3" "target-features"="+bigcore" }
  attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) "target-cpu"="xpu3" "target-features"="+bigcore" }
  attributes #2 = { nounwind memory(write) }

...
