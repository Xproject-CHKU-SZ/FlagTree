    %34:grregs = EXP_RN_V3 killed %33
    %36:vrregs = XPUVZero
    %37:mrregs = MaskConstant32 1, $zero
    %38:vrregs = VOR_VR_U_H killed %37, killed %34, killed %36, killed %36
