body:             |
  bb.0.entry:
    liveins: $r2, $r3
  
    %1:grregs = COPY $r3
    %0:grregs = COPY $r2
    %2:vrregs = VLOAD_M16_MZ $mr1, %1, 0 :: (load (s512) from %ir.in)
    %3:grregs = VEXTRACTI_F %2, 15
