+def _valid_benchmark_ms(value: Any) -> bool:
+    return (
+        isinstance(value, (int, float))
+        and not isinstance(value, bool)
+        and value > 0
+        and math.isfinite(value)
+    )
+
+
+def _benchmark_valid_choices(
+    choices: list[ChoiceCaller],
+    benchmark: Callable[[Any], dict[ChoiceCaller, float]],
+) -> dict[ChoiceCaller, float]:
+    samples = benchmark(choices)
+    assert all(c in samples for c in choices)
+    for _ in range(2):
+        # +inf is the dispatcher's sentinel for failed/unsupported kernels.
+        # Nonfinite numeric event readings have already been retried at source.
+        retry = [
+            c for c in choices
+            if not _valid_benchmark_ms(samples[c]) and samples[c] != math.inf
+        ]
+        if not retry:
+            break
+        fresh = benchmark(retry)
+        assert all(c in fresh for c in retry)
+        samples.update(fresh)
+    return {c: samples[c] for c in choices if _valid_benchmark_ms(samples[c])}
+
